@model SessionDetailsVm

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Керування сеансом";
}

<div class="container mt-4">
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">🗓 До розкладу</a>
        <a asp-action="Edit" asp-route-id="@Model.SessionId" class="btn btn-warning @(Model.Seats.Any(s => s.IsTaken) ? "disabled" : "")">✏️ Редагувати</a>
    </div>

    <h2 class="mb-4 text-primary">🛠 Моніторинг: @Model.MovieTitle</h2>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h5 class="card-title">ℹ️ Технічні дані</h5>
                    <hr />
                    <p><b>Кінотеатр:</b> @Model.CinemaName</p>
                    <p><b>Зал:</b> @Model.HallName</p>
                    <p><b>Час:</b> @Model.StartTime.ToString("HH:mm") — @Model.EndTime.ToString("HH:mm")</p>
                    <hr />
                    <p class="mb-1">Заповненість: <b>@Model.Seats.Count(s => s.IsTaken) / @Model.Seats.Count</b></p>
                    <div class="progress" style="height: 10px;">
                        @{ var percent = (Model.Seats.Count(s => s.IsTaken) * 100) / (Model.Seats.Count > 0 ? Model.Seats.Count : 1); }
                        <div class="progress-bar bg-info" role="progressbar" style="width: @percent%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="text-center mb-4">Стан залу (тільки перегляд)</h5>
                    <div class="text-center fw-bold small text-muted mb-2">ЕКРАН</div>
                    <div class="w-100" style="overflow-x:auto;">
                        <div style="min-width: 600px; display:flex; flex-direction:column; gap:8px; align-items:center;">
                            @for (int r = 1; r <= Model.Rows; r++)
                            {
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span class="small text-muted" style="width:50px;">Ряд @r</span>
                                    @for (int n = 1; n <= Model.SeatsPerRow; n++)
                                    {
                                        var seat = Model.Seats.FirstOrDefault(x => x.Row == r && x.Number == n);
                                        <div style="width:32px; height:28px; border-radius:4px; border:1px solid #ddd; 
                                                    background-color:@(seat == null ? "transparent" : (seat.IsTaken ? "#0dcaf0" : "#fff"));
                                                    display:flex; align-items:center; justify-content:center; font-size:11px;">
                                            @(seat?.Number.ToString() ?? "")
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mt-4 d-flex justify-content-center gap-3 small">
                        <span><span class="d-inline-block shadow-sm" style="width:15px; height:15px; background:#0dcaf0; border:1px solid #ddd;"></span> Продано</span>
                        <span><span class="d-inline-block shadow-sm" style="width:15px; height:15px; background:#fff; border:1px solid #ddd;"></span> Вільно</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>