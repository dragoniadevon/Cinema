@model SessionDetailsVm
@{
    Layout = Model.IsAdminView ? "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml" : "_Layout";
    ViewData["Title"] = $"Адмін: {Model.MovieTitle}";

    var standardPrice = Model.Prices.FirstOrDefault(p => !p.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase))?.Price ?? 0;
    var vipPrice = Model.Prices.FirstOrDefault(p => p.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase))?.Price ?? 0;

    var hasStandard = Model.Seats.Any(s => !s.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase));
    var hasVip = Model.Seats.Any(s => s.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase));
}
<div id="antiforgery-container">
    @Html.AntiForgeryToken()
</div>
<div class="container mt-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="border-radius: 20px; top: 20px; background: transparent;">
                <div class="poster-wrapper shadow-sm">
                    <img src="@(string.IsNullOrEmpty(Model.Posterurl) ? "https://placehold.co/400x600?text=No+Poster" : Model.Posterurl)" 
                         class="poster-img" 
                         alt="@Model.MovieTitle">
                    
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge bg-warning text-dark px-3 py-2 fw-bold shadow-sm">@Model.AgeRestriction</span>
                    </div>
                </div>
                
                <div class="mt-3 d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.SessionId" class="btn btn-outline-primary rounded-pill fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Редагувати сеанс
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="ps-2 mb-4">
                <div class="badge bg-danger mb-2 px-3 py-2 rounded-pill text-uppercase" style="letter-spacing: 1px; font-size: 0.7rem;">Панель адміністратора</div>
                <h1 class="fw-bold text-dark mb-1 display-5">@Model.MovieTitle</h1>
                
                <div class="d-flex flex-wrap align-items-center gap-2 text-muted mb-1">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                    <span>Луцьк, @Model.CinemaName</span>
                    <span class="text-primary opacity-50">|</span>
                    <i class="bi bi-door-open-fill text-primary"></i>
                    <span>Зал @Model.HallName</span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="fw-bold text-dark fs-5">
                        <i class="bi bi-calendar-event text-primary me-1"></i>
                        @Model.StartTime.ToString("dd MMMM")
                        <span class="ms-2">@Model.StartTime.ToString("HH:mm") — @Model.EndTime.ToString("HH:mm")</span>
                    </div>
                    <span class="badge bg-primary px-3 rounded-pill">@Model.Duration хв.</span>
                    <span class="badge bg-dark px-3 rounded-pill">@(Model.Duration > 120 ? "2D" : "3D")</span> 
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0">Схема залу</h5>
                <button id="admin-lock-btn" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm" onclick="toggleAdminLockMode()">
                    <i class="bi bi-shield-lock me-2"></i>Увімкнути режим блокування
                </button>
            </div>
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="d-flex justify-content-center gap-5 mb-4 flex-wrap">
                    @if (hasStandard)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="seat-legend bg-standard"></div>
                            <div class="d-flex flex-column text-black">
                                <span class="category-label fw-bold">Звичайне</span>
                                <span class="price-value">@standardPrice.ToString("0") ₴</span>
                            </div>
                        </div>
                    }
                    @if (hasVip)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="seat-legend bg-vip-green"></div>
                            <div class="d-flex flex-column text-black">
                                <span class="category-label fw-bold">VIP</span>
                                <span class="price-value">@vipPrice.ToString("0") ₴</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="screen-container text-center mb-4">
                    <div class="screen-curve mx-auto"></div>
                    <span class="screen-text text-uppercase">Екран</span>
                </div>

                <div class="hall-scroll-container">
                    <div class="hall-layout">
                        @for (int r = 1; r <= Model.Rows; r++)
                        {
                            var rowSeats = Model.Seats.Where(s => s.Row == r).OrderBy(s => s.Number).ToList();
                            var isVipRow = rowSeats.All(s => s.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase));
            
                            <div class="seat-row">
                                <div class="seats-row-wrapper @(isVipRow ? "vip-style" : "standard-style")">
                                    @foreach (var seat in rowSeats)
                                    {
                                        var isVip = seat.CategoryName.Contains("VIP", StringComparison.OrdinalIgnoreCase);
                                        // Додаємо клас is-blocked, якщо місце заблоковане в БД
                                        string seatTypeClass = seat.IsBlocked ? "is-blocked" : (seat.IsTaken ? "is-taken" : (isVip ? "is-vip" : "is-standard"));

                                        <button type="button" 
                                                class="seat-btn admin-mode @seatTypeClass" 
                                                data-seat-id="@seat.SeatId" 
                                                data-row="@r" 
                                                data-num="@seat.Number"
                                                data-category="@seat.CategoryName"
                                                data-is-taken="@seat.IsTaken.ToString().ToLower()"
                                                data-info='{"name":"@seat.CustomerName", "email":"@seat.CustomerEmail", "price":"@seat.Price", "date":"@seat.PurchaseDate?.ToString("dd.MM.yyyy HH:mm")"}'
                                                onclick="handleSeatClick(this)">
                                            @if (seat.IsBlocked) { <i class="bi bi-tools"></i> }
                                            else if (seat.IsTaken) { <i class="bi bi-x-lg"></i> }
                                            else { @seat.Number }
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="mt-4 pt-3 border-top d-flex justify-content-around text-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Зайнято</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Seats.Count(s => s.IsTaken)</div>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Вільних</div>
                        <div class="fs-4 fw-bold text-primary">@Model.Seats.Count(s => !s.IsTaken)</div>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Всього місць</div>
                        <div class="fs-4 fw-bold text-secondary">@Model.Seats.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* --- SIDE PANEL: ДЕТАЛІ КВИТКА --- *@
<div class="offcanvas offcanvas-end border-0 shadow" tabindex="-1" id="adminSeatPanel" style="border-radius: 30px 0 0 30px; width: 400px;">
    <div class="offcanvas-header border-bottom p-4">
        <h5 class="offcanvas-title fw-bold text-primary"><i class="bi bi-info-circle-fill me-2"></i>Керування місцем</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-4 text-black">
        <div id="seat-info-content">
            <div class="text-center mb-4">
                <div class="display-5 fw-bold text-dark" id="panel-seat-label">Ряд 0, Місце 0</div>
                <span class="badge bg-light text-secondary border px-3 py-2 mt-2 fs-6" id="panel-seat-type">Категорія</span>
            </div>

            @* Блок для зайнятого місця *@
            <div id="sold-info-section" class="d-none">
                <h6 class="fw-bold text-muted text-uppercase small mb-3">Інформація про покупця</h6>
                <div class="card bg-light border-0 p-4 mb-4 rounded-4 shadow-sm">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>
                        <div class="text-truncate">
                            <div class="fw-bold fs-5 text-truncate" id="customer-name">Завантаження...</div>
                            <div class="small text-muted text-truncate" id="customer-email">---</div>
                        </div>
                    </div>
                    <hr class="my-2 opacity-25">
                    <div class="d-flex justify-content-between small py-2">
                        <span class="text-muted">Дата транзакції:</span>
                        <span class="fw-bold" id="trans-date">---</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Ціна покупки:</span>
                        <span class="fw-bold text-success fs-5" id="purchase-price">0 ₴</span>
                    </div>
                </div>
                <button class="btn btn-danger w-100 py-3 rounded-pill fw-bold shadow-sm" onclick="cancelTicketAction()">
                    <i class="bi bi-trash3 me-2"></i>СКАСУВАТИ КВИТОК
                </button>
            </div>

            @* Блок для вільного місця *@
            <div id="free-info-section" class="d-none">
                <div class="alert alert-info border-0 rounded-4 shadow-sm py-3 text-center">
                    <i class="bi bi-check-circle-fill fs-1 d-block mb-2 text-success"></i>
                    Це місце вільне
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Місце, яке вже заблоковане в базі */
    .is-blocked { 
        background-color: #000000 !important; 
        color: #ffc107 !important; 
        border: 1px solid #333 !important;
    }

    /* Стан кнопки, коли вона просто обрана для масової дії */
    .seat-btn.to-be-blocked {
        background-color: #ffc107 !important;
        color: #000 !important;
        border: 2px dashed #000 !important;
    }

    /* Режим блокування: робимо кнопки курсором "вказівний палець" */
    .hall-admin-active .seat-btn:not(.is-taken) {
        cursor: pointer !important;
    }
    /* --- 1. АФІША ТА ПОСТЕР --- */
    .poster-wrapper {
        width: 100%;
        height: 550px;
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        background-color: #f8f9fa;
    }
    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* --- 2. ЛЕГЕНДА --- */
    .seat-legend { width: 32px; height: 26px; border-radius: 7px; }
    .bg-standard, .is-standard { background-color: #6c757d !important; color: white; }
    .bg-vip-green, .is-vip { background-color: #198754 !important; color: white; }
    .price-value { font-size: 1.2rem; font-weight: 900; }

    /* --- 3. СХЕМА ЗАЛУ --- */
    .screen-curve { width: 80%; height: 5px; background: #343a40; border-radius: 50% / 100% 100% 0 0; }
    .screen-text { font-size: 11px; font-weight: 800; letter-spacing: 6px; color: #495057; }
    .hall-scroll-container { max-height: 550px; overflow: auto; padding: 5px 0; }
    .hall-layout { display: flex; flex-direction: column; align-items: center; min-width: max-content; padding: 20px 40px; }
    .seat-row { display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }
    .seats-row-wrapper { display: flex; gap: 8px; }
    .vip-style { gap: 18px; margin-top: 10px; }

    /* Місця в адмін-режимі (div замість button) */
    .seat-btn { 
        width: 36px; height: 30px; border-radius: 7px; font-size: 13px; font-weight: bold; 
        line-height: 30px; text-align: center; flex-shrink: 0; display: inline-flex; 
        align-items: center; justify-content: center; cursor: default;
    }
    .is-taken { background-color: #e9ecef !important; color: #adb5bd !important; border: 1px solid #dee2e6 !important; }
    .row-label { width: 30px; font-size: 12px; text-align: center; }

    @@media (max-width: 991.98px) {
        .poster-wrapper { height: 450px; max-width: 350px; margin: 0 auto; }
    }
</style>
<script>
    let isLockMode = false;
    let seatsToChange = []; // масив ID вибраних місць

    function toggleAdminLockMode() {
        const mainBtn = document.getElementById('admin-lock-btn');
        const hallGrid = document.querySelector('.hall-layout');
    
        if (!isLockMode) {
            // ВХІД У РЕЖИМ
            isLockMode = true;
            hallGrid.classList.add('hall-admin-active');
            mainBtn.classList.replace('btn-dark', 'btn-warning');
            mainBtn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Застосувати зміни';
        } else {
            // ВИХІД ТА ЗАСТОСУВАННЯ
            if (seatsToChange.length > 0) {
                applyBulkLock();
            } else {
                resetLockMode();
            }
        }
    }

    // Функція кліку по самому кріслу
    function handleSeatClick(btn) {
        if (!isLockMode) return; // якщо режим не ввімкнено - нічого не робимо
        if (btn.classList.contains('is-taken')) return; // зайняті не чіпаємо

        const seatId = btn.dataset.seatId;
        const index = seatsToChange.indexOf(seatId);

        if (index > -1) {
            seatsToChange.splice(index, 1);
            btn.classList.remove('to-be-blocked');
        } else {
            seatsToChange.push(seatId);
            btn.classList.add('to-be-blocked');
        }
    }

    async function applyBulkLock() {
        if (seatsToChange.length === 0) return;

        // Отримуємо токен захисту (AntiForgeryToken)
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Виконуємо запити для кожного вибраного місця паралельно
        const promises = seatsToChange.map(id => 
            fetch(`/Admin/Sessions/ToggleBlockSeat?seatId=${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
        );

        try {
            await Promise.all(promises);
            location.reload(); // Перезавантажуємо сторінку після завершення всіх запитів
        } catch (error) {
            console.error("Помилка при блокуванні:", error);
            alert("Сталася помилка при збереженні змін.");
        }
    }

    function resetLockMode() {
        isLockMode = false;
        seatsToChange = [];
        document.getElementById('admin-lock-btn').classList.replace('btn-warning', 'btn-dark');
        document.getElementById('admin-lock-btn').innerHTML = '<i class="bi bi-shield-lock me-2"></i>Увімкнути режим блокування';
        document.querySelector('.hall-layout').classList.remove('hall-admin-active');
    }

    // Змінна для збереження поточного ID місця
let currentActiveSeatId = null;

function handleSeatClick(btn) {
    // Якщо ввімкнено режим блокування - використовуємо твою стару логіку блокування
    if (isLockMode) {
        // ... (твоя функція вибору для блокування)
        const seatId = btn.dataset.seatId;
        const index = seatsToChange.indexOf(seatId);
        if (index > -1) {
            seatsToChange.splice(index, 1);
            btn.classList.remove('to-be-blocked');
        } else {
            seatsToChange.push(seatId);
            btn.classList.add('to-be-blocked');
        }
        return;
    }

    // ЛОГІКА ДЕТАЛЕЙ КВИТКА (звичайний клік в адмінці)
    currentActiveSeatId = btn.dataset.seatId;
    const isTaken = btn.dataset.isTaken === "true";
    const info = JSON.parse(btn.dataset.info);

    document.getElementById('panel-seat-label').innerText = `Ряд ${btn.dataset.row}, Місце ${btn.dataset.num}`;
    document.getElementById('panel-seat-type').innerText = btn.dataset.category;

    if (isTaken) {
        document.getElementById('sold-info-section').classList.remove('d-none');
        document.getElementById('free-info-section').classList.add('d-none');
        
        document.getElementById('customer-name').innerText = info.name || "Гість";
        document.getElementById('customer-email').innerText = info.email || "не вказано";
        document.getElementById('purchase-price').innerText = info.price + " ₴";
        document.getElementById('trans-date').innerText = info.date || "---";
    } else {
        document.getElementById('sold-info-section').classList.add('d-none');
        document.getElementById('free-info-section').classList.remove('d-none');
    }

    const bsPanel = new bootstrap.Offcanvas(document.getElementById('adminSeatPanel'));
    bsPanel.show();
}

async function cancelTicketAction() {
    if (!confirm("Ви впевнені, що хочете скасувати цей квиток? Місце стане вільним.")) return;

    // Отримуємо токен з нашого контейнера
    const tokenElement = document.querySelector('#antiforgery-container input[name="__RequestVerificationToken"]');
    if (!tokenElement) {
        alert("Помилка безпеки: токен не знайдено.");
        return;
    }
    const token = tokenElement.value;
    
    try {
        // Використовуємо URLSearchParams для надійної передачі параметрів
        const params = new URLSearchParams();
        params.append('seatId', currentActiveSeatId);
        params.append('sessionId', '@Model.SessionId');

        const response = await fetch(`/Admin/Sessions/CancelTicket`, {
            method: 'POST',
            headers: { 
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded', // Важливо для [HttpPost]
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: params // Передаємо дані в тілі запиту
        });

        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                location.reload(); 
            } else {
                alert(result.message || "Помилка при скасуванні");
            }
        } else {
            // Якщо сервер повернув 400, 404 або 500
            alert(`Помилка сервера: Код ${response.status}`);
        }
    } catch (e) {
        console.error(e);
        alert("Помилка виконання запиту. Перевірте консоль браузера (F12).");
    }
}
</script>