@model IEnumerable<global::Cinema.Web.Models.Sessions.SessionsByDateVm>
@using global::Cinema.Infrastructure.Entities
@using global::Cinema.Infrastructure.Entities.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Керування розкладом";
    var now = DateTime.Now;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">🗓️ Панель керування розкладом</h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm">+ Додати сеанс</a>
    </div>

    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <input type="hidden" name="mode" value="@(ViewBag.CurrentMode ?? "active")" />
                
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Місто</label>
                    <select name="city" class="form-select border-0 shadow-sm">
                        <option value="">Всі міста</option>
                        @foreach (var city in (List<string>)ViewBag.Cities)
                        {
                            <option value="@city" selected="@(ViewBag.SelectedCity == city)">@city</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Кінотеатр</label>
                    <select name="cinemaId" class="form-select border-0 shadow-sm">
                        <option value="">Всі кінотеатри</option>
                        @foreach (var cinema in (List<global::Cinema.Infrastructure.Entities.Cinema>)ViewBag.Cinemas)
                        {
                            <option value="@cinema.Id" 
                                    data-city="@cinema.City" 
                                    selected="@(ViewBag.SelectedCinema == cinema.Id)">
                                @cinema.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary">Дата</label>
                    <input type="date" name="date" class="form-control border-0 shadow-sm" value="@ViewBag.SelectedDate" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 shadow-sm">Застосувати</button>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Скинути</a>
                </div>
            </form>
        </div>
    </div>

    <ul class="nav nav-pills mb-4 bg-white p-2 rounded shadow-sm">
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentMode == "active" ? "active" : "")" 
               asp-action="Index" asp-route-mode="active" 
               asp-route-cinemaId="@ViewBag.SelectedCinema">📅 Активні</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentMode == "past" ? "active bg-secondary text-white" : "")" 
               asp-action="Index" asp-route-mode="past" 
               asp-route-cinemaId="@ViewBag.SelectedCinema">📜 Архів (минулі)</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentMode == "cancelled" ? "active bg-danger text-white" : "text-danger")" 
               asp-action="Index" asp-route-mode="cancelled" 
               asp-route-cinemaId="@ViewBag.SelectedCinema">🚫 Скасовані</a>
        </li>
    </ul>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center border py-5 shadow-sm">
            <i class="bi bi-calendar-x display-4 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">Сеансів не знайдено за заданими фільтрами.</p>
        </div>
    }
    else 
    {
            bool pastSectionStarted = false; // Маркер для лінії відокремлення

        @foreach (var dateGroup in Model)
        {
            var isPast = dateGroup.Date < DateTime.Today;

            @* ЛІНІЯ ВІДОКРЕМЛЕННЯ: якщо ми в режимі "Скасовані" і переходимо від майбутніх до минулих дат *@
            @if (ViewBag.CurrentMode == "cancelled" && isPast && !pastSectionStarted)
            {
                pastSectionStarted = true;
                <div class="col-12 my-5">
                    <div class="d-flex align-items-center">
                        <hr class="flex-grow-1 border-secondary opacity-25">
                        <span class="mx-3 fw-bold text-muted small text-uppercase" style="letter-spacing: 2px;">
                            📜 Історія попередніх скасувань
                        </span>
                        <hr class="flex-grow-1 border-secondary opacity-25">
                    </div>
                </div>
            }

            @* Прибрано applyOpacity: тепер картки завжди яскраві *@
            <div class="date-section mb-5 p-3 bg-white rounded shadow-sm border">
                <h3 class="py-2 mb-4 border-bottom fw-bold d-flex justify-content-between align-items-center @(isPast ? "text-muted" : "text-secondary")">
                    <span>📅 @dateGroup.Date.ToString("dd MMMM yyyy, dddd")</span>
                </h3>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @{
                        var flattenedMovies = dateGroup.Cinemas
                            .SelectMany(c => c.Movies.Select(m => new { CinemaId = c.CinemaId, CinemaName = c.CinemaName, Movie = m }))
                            .GroupBy(x => x.Movie.Title);
                    }

                    @foreach (var movieGroup in flattenedMovies)
                    {
                        var firstMovieItem = movieGroup.First();
                        var firstMovie = firstMovieItem.Movie;
                        var posterUrl = firstMovie.Sessions.FirstOrDefault()?.Movie?.Posterurl;

                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-5 hover-card bg-white">
                                <div class="row g-0 h-100">
                                    <div class="col-5 position-relative overflow-hidden" style="border-radius: 25px 0 0 25px;">
                                        <a href="@Url.Action("Details", "Movies", new { area = "Admin", id = firstMovie.MovieId })" class="d-block h-100">
                                            <img src="@(string.IsNullOrEmpty(posterUrl) ? "/images/no-poster.png" : posterUrl)" 
                                                 class="w-100 h-100 object-fit-cover poster-zoom" 
                                                 style="min-height: 230px;">
                                        </a>
                
                                        <div class="position-absolute top-0 end-0 m-2">
                                            <span class="badge bg-warning text-dark fw-bold rounded-3 shadow-sm" style="font-size: 0.65rem;">
                                                @firstMovie.Agerating
                                            </span>
                                        </div>
                                    </div>

                                    <div class="col-7">
                                        <div class="card-body d-flex flex-column h-100 p-3"> 
                                                <h5 class="card-title fw-bold text-dark mb-1 text-truncate-2" style="font-size: 1.25rem;">@firstMovie.Title</h5>                                            <p class="small text-muted mb-2">
                                                <i class="bi bi-clock-history me-1"></i>@firstMovie.Duration хв.
                                            </p>

                                            <div class="cinema-sessions-list">
                                                @foreach (var cinemaItem in movieGroup)
                                                {
                                                    <div class="mb-3">
                                                        <div class="cinema-label text-dark mb-1" style="font-size: 0.9rem; line-height: 1.2;">
                                                            <i class="bi bi-geo-alt text-primary"></i> 
                                                            <strong>@cinemaItem.CinemaName (@cinemaItem.Movie.Sessions.First().Hall.Cinema.City)</strong>
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-1">
                                                            @foreach (var session in cinemaItem.Movie.Sessions)
                                                            {
                                                                @* Визначаємо колір кнопки часу *@
                                                                string btnColorClass = "text-dark";
                                                                if (session.PaidCount > 0) btnColorClass = "text-info";
                                                                else if (session.RefundedCount > 0 || session.CancelledResCount > 0) btnColorClass = "text-danger";

                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm border-0 p-1 fw-black session-minimal-btn dropdown-toggle @btnColorClass" 
                                                                            type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 1.1rem;">
                                                                        @session.Starttime.ToString("HH:mm")
                                                                        @if (session.PaidCount > 0 && (session.RefundedCount > 0 || session.CancelledResCount > 0))
                                                                        {
                                                                            <sup class="text-danger" style="font-size: 0.7rem;">*</sup>
                                                                        }
                                                                    </button>
        
                                                                    <ul class="dropdown-menu shadow-lg border-0 rounded-4 p-2" style="min-width: 220px;">
                                                                        <li class="px-3 py-1 small border-bottom mb-2 text-muted">
                                                                            Зал: <strong>@session.Hall?.Name</strong><br/>
                                                                            Формат: <strong>@(session.Format == 2 ? "3D" : "2D")</strong>
                                                                        </li>
            
                                                                        @if (session.PaidCount > 0)
                                                                        {
                                                                            <li class="px-3 py-1 d-flex justify-content-between align-items-center small">
                                                                                <span>✅ Оплачено:</span> <span class="badge bg-info rounded-pill">@session.PaidCount</span>
                                                                            </li>
                                                                        }
            
                                                                        @if (session.RefundedCount > 0)
                                                                        {
                                                                            <li class="px-3 py-1 d-flex justify-content-between align-items-center small">
                                                                                <span class="text-warning">🔄 Повернено:</span> <span class="badge bg-warning text-dark rounded-pill">@session.RefundedCount</span>
                                                                            </li>
                                                                        }

                                                                        @if (session.CancelledResCount > 0)
                                                                        {
                                                                            <li class="px-3 py-1 d-flex justify-content-between align-items-center small">
                                                                                <span class="text-danger">❌ Ск. броней:</span> <span class="badge bg-danger rounded-pill">@session.CancelledResCount</span>
                                                                            </li>
                                                                        }

                                                                        <li class="border-top mt-2 pt-2">
                                                                            <a asp-action="Details" asp-route-id="@session.Id" class="dropdown-item rounded-3 small mb-1">👁️ Деталі сеансу</a>

                                                                        @if (ViewBag.CurrentMode == "active")
                                                                        {
                                                                            if (session.ActiveTicketsCount == 0)
                                                                            {
                                                                                <li><a asp-action="Edit" asp-route-id="@session.Id" class="dropdown-item rounded-3 small mb-1">✏️ Редагувати</a></li>
                                                                                <li>
                                                                                    <button class="dropdown-item rounded-3 small text-danger" 
                                                                                            data-bs-toggle="modal" data-bs-target="#deleteSessionModal" 
                                                                                            data-id="@session.Id" 
                                                                                            data-info="@session.Starttime.ToString("HH:mm") - @firstMovie.Title">
                                                                                        🗑️ Видалити сеанс
                                                                                    </button>
                                                                                </li>
                                                                            }
                                                                            else
                                                                            {
                                                                                <li>
                                                                                    <button class="dropdown-item rounded-3 small text-warning" 
                                                                                            data-bs-toggle="modal" data-bs-target="#cancelSessionModal" 
                                                                                            data-id="@session.Id" 
                                                                                            data-info="@session.Starttime.ToString("HH:mm") - @firstMovie.Title">
                                                                                        🚫 Скасувати сеанс
                                                                                    </button>
                                                                                </li>
                                                                            }
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    @if (ViewBag.HasNextPage == true)
    {
        <div class="text-center my-5 pb-5">
            <a href="@Url.Action("Index", new { 
                mode = ViewBag.CurrentMode, 
                city = ViewBag.SelectedCity, 
                cinemaId = ViewBag.SelectedCinema, 
                date = ViewBag.SelectedDate, 
                page = (int)ViewBag.Page + 1 
            })" class="btn btn-outline-primary btn-lg rounded-pill px-5 shadow-sm">
                <i class="bi bi-arrow-down-circle me-2"></i> Показати наступні 5 днів
            </a>
        </div>
    }
</div>

<div class="modal fade" id="deleteSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">Видалити сеанс</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4 text-center">
                Ви впевнені, що хочете безповоротно видалити сеанс:<br />
                <strong id="deleteSessionInfo" class="fs-5"></strong>?
            </div>
            <div class="modal-footer bg-light border-0">
                <form id="deleteSessionForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">Так, видалити</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">Скасувати сеанс</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4 text-center">
                <div class="alert alert-warning border-0 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i> На цей сеанс вже є квитки!
                </div>
                Ви впевнені, що хочете скасувати сеанс:<br />
                <strong id="cancelSessionInfo" class="fs-5"></strong>?
            </div>
            <div class="modal-footer bg-light border-0">
                <form id="cancelSessionForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Підтвердити скасування</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Назад</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteModal = document.getElementById('deleteSessionModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const info = button.getAttribute('data-info');
                    document.getElementById('deleteSessionInfo').innerText = info;
                    document.getElementById('deleteSessionForm').action = '/Admin/Sessions/Delete/' + id;
                });
            }

            const cancelModal = document.getElementById('cancelSessionModal');
            if (cancelModal) {
                cancelModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const info = button.getAttribute('data-info');
                    document.getElementById('cancelSessionInfo').innerText = info;
                    document.getElementById('cancelSessionForm').action = '/Admin/Sessions/Cancel/' + id;
                });
            }

            const citySelect = document.querySelector('select[name="city"]');
            if (citySelect) {
                citySelect.addEventListener('change', function() {
                    const selectedCity = this.value.toLowerCase();
                    const cinemaSelect = document.querySelector('select[name="cinemaId"]');
                    const options = cinemaSelect.querySelectorAll('option');

                    options.forEach(option => {
                        if (option.value === "") return; 
                        const cityAttr = option.getAttribute('data-city')?.toLowerCase();
                        if (!selectedCity || cityAttr === selectedCity) {
                            option.style.display = 'block';
                        } else {
                            option.style.display = 'none';
                            if (cinemaSelect.value === option.value) cinemaSelect.value = "";
                        }
                    });
                });
            }
        });
    </script>
}

<style>
    .rounded-5 { border-radius: 25px !important; }
    .hover-card { 
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); 
        border: 1px solid #f0f0f0 !important;
    }
    .hover-card:hover { 
        transform: translateY(-5px); 
        box-shadow: 0 10px 25px rgba(0,0,0,0.07) !important; 
    }
    .poster-zoom { transition: transform 0.6s ease; }
    .hover-card:hover .poster-zoom { transform: scale(1.08); }
    .session-minimal-btn { 
        background: transparent !important;
        transition: all 0.2s ease;
        box-shadow: none !important;
        position: relative;
        z-index: 1;
    }    
    .session-minimal-btn:hover { 
        color: #0d6efd !important; 
        transform: scale(1.15);
    }    
    .session-minimal-btn::after { display: none; }
    .text-truncate-2 { 
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
        min-height: 2.8em; 
        line-height: 1.4; 
    }
    .col:has(.show) {
        position: relative;
        z-index: 1050;
    }
    .dropdown-menu {
        position: fixed !important;
        z-index: 1100 !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
        border: 1px solid #eee !important;
    }
    .hover-card {
        height: 100%; /* Картка займає всю висоту колонки сітки */
        display: flex;
        flex-direction: column;
    }
    .hover-card .row.g-0 {
        flex-grow: 1; /* Ряд розтягується на всю висоту картки */
    }
    /* Обмежуємо висоту контентної частини, щоб картки не розповзалися */
    .cinema-sessions-list {
        flex-grow: 1;
        overflow-y: auto;
        max-height: 180px; /* Фіксована висота для списку сеансів */
        min-height: 180px; /* Гарантує, що всі картки будуть однакового розміру */
        padding-right: 5px;
    }

    /* Стилізація скроллбару всередині картки */
    .cinema-sessions-list::-webkit-scrollbar {
        width: 4px;
    }
    .cinema-sessions-list::-webkit-scrollbar-thumb {
        background: #e9ecef;
        border-radius: 10px;
    }
    .poster-zoom {
        object-fit: cover;
        height: 100% !important;
        min-height: 100%;
    }
    .badge { font-size: 0.65rem; padding: 0.35em 0.65em; }
    .bi-cash-stack { font-size: 0.7rem; vertical-align: top; margin-left: 2px; }
    .text-warning { color: #ffc107 !important; }
</style>