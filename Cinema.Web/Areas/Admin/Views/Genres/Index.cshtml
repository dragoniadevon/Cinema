@model IEnumerable<Genre>

@{
    ViewData["Title"] = "Жанри";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">🎭 Жанри</h1>
            <p class="text-muted small mb-0">Категорії для класифікації фільмів</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg me-1"></i> Додати жанр
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center border py-5 shadow-sm">
            <i class="bi bi-tags display-4 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">Жанрів поки немає.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Назва жанру</th>
                                <th class="pe-4 py-3 text-uppercase small fw-bold text-muted text-end" style="width:150px">
                                    Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var genre in Model)
                            {
                                <tr class="genre-row">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-2 p-2">
                                                <i class="bi bi-tag-fill"></i>
                                            </span>
                                            <span class="fw-bold text-dark">@genre.Name</span>
                                        </div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group shadow-sm rounded">
                                            <a asp-action="Edit" asp-route-id="@genre.Id"
                                                class="btn btn-white btn-sm border-end" title="Редагувати">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <button class="btn btn-white btn-sm text-danger" data-bs-toggle="modal"
                                                data-bs-target="#deleteGenreModal" data-id="@genre.Id" data-name="@genre.Name"
                                                title="Видалити">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="deleteGenreModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">⚠️ Видалити жанр</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="text-muted mb-2">Ви впевнені, що хочете видалити цей жанр?</p>
                <h5 class="fw-bold" id="genreName"></h5>
                <p class="small text-danger mt-3">
                    <i class="bi bi-info-circle"></i> Це може вплинути на відображення фільмів у цій категорії.
                </p>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <form id="deleteGenreForm" method="post" class="w-100 px-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100 shadow-sm mb-2">Підтвердити видалення</button>
                    <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Скасувати</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border-bottom: none;
    }

    .genre-row {
        transition: background-color 0.2s ease;
    }

    .genre-row:hover {
        background-color: #f8f9fa;
    }

    .btn-white {
        background-color: #fff;
        border: 1px solid #dee2e6;
    }

    .btn-white:hover {
        background-color: #f8f9fa;
    }
</style>

@section Scripts {
    <script>
        const deleteGenreModal = document.getElementById('deleteGenreModal');
        deleteGenreModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const genreId = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');

            document.getElementById('genreName').innerText = name;
            document.getElementById('deleteGenreForm').action = '/Admin/Genres/Delete/' + genreId;
        });
    </script>
}