@model IEnumerable<Actor>

@{
    ViewData["Title"] = "Актори";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">🎭 Актори</h1>
            <p class="text-muted small mb-0">Керування списком акторів та їх ролями</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-person-plus-fill me-1"></i> Додати актора
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center border py-5 shadow-sm">
            <i class="bi bi-people display-4 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">Список акторів порожній.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Імʼя актора</th>
                                <th class="pe-4 py-3 text-uppercase small fw-bold text-muted text-end" style="width:150px">
                                    Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var actor in Model)
                            {
                                <tr class="actor-row">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-2 p-2">
                                                <i class="bi bi-person-fill"></i>
                                            </span>
                                            <span class="fw-bold text-dark">@actor.Fullname</span>
                                        </div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group shadow-sm rounded">
                                            <a asp-action="Edit" asp-route-id="@actor.Id"
                                                class="btn btn-white btn-sm border-end" title="Редагувати">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <button class="btn btn-white btn-sm text-danger" data-bs-toggle="modal"
                                                data-bs-target="#deleteActorModal" data-id="@actor.Id"
                                                data-name="@actor.Fullname" title="Видалити">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="deleteActorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">⚠️ Видалити актора</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="text-muted mb-2">Ви впевнені, що хочете видалити цього актора?</p>
                <h5 class="fw-bold" id="actorName"></h5>
                <p class="small text-danger mt-3">
                    <i class="bi bi-exclamation-triangle"></i> Це видалить його з усіх пов'язаних фільмів.
                </p>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <form id="deleteActorForm" method="post" class="w-100 px-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100 shadow-sm mb-2">Підтвердити видалення</button>
                    <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Скасувати</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border-bottom: none;
    }

    .actor-row {
        transition: background-color 0.2s ease;
    }

    .actor-row:hover {
        background-color: #f8f9fa;
    }

    .btn-white {
        background-color: #fff;
        border: 1px solid #dee2e6;
    }

    .btn-white:hover {
        background-color: #f8f9fa;
    }
</style>

@section Scripts {
    <script>
        const deleteActorModal = document.getElementById('deleteActorModal');
        deleteActorModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const actorId = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');

            document.getElementById('actorName').innerText = name;
            document.getElementById('deleteActorForm').action = '/Actors/Delete/' + actorId;
        });
    </script>
}