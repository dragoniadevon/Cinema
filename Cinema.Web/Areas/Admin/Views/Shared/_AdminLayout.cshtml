<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema.Web.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center fw-bold text-primary" asp-area="Admin"
                       asp-controller="Home" asp-action="Index">
                    <span class="me-2">🛠️</span> АДМІНКА
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#adminNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="Movies"
                               asp-action="Index">Фільми</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="Genres"
                               asp-action="Index">Жанри</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="Actors"
                               asp-action="Index">Актори</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="Cinemas"
                               asp-action="Index">Кінотеатри</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="Sessions"
                               asp-action="Index">Сеанси</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-area="Admin" asp-controller="PriceCategories"
                               asp-action="Index">Ціни</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="user-badge shadow-sm">
                                    <i class="bi bi-person-badge-fill me-2"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill shadow-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i> Вийти
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container pb-5">
            @RenderBody()
        </div>
    </main>

    <footer class="footer text-muted border-top bg-white py-4 mt-auto">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <span>&copy; 2026 - Illusion Hall - Адмін-панель</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy"
                   class="text-decoration-none">Конфіденційність</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>