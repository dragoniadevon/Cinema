@model IEnumerable<Cinema>

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <span style="font-size: 2.5rem; margin-right: 15px;">🏢</span>
            <h1 class="mb-0 fw-bold">Кінотеатри</h1>
        </div>
        
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">
                + Додати кінотеатр
            </a>
        </div>
    </div>

    @{ bool showedArchiveHeader = false; }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var cinema in Model)
    {
        @if (!cinema.Isactive && !showedArchiveHeader)
        {
            showedArchiveHeader = true;
            <div class="archive-divider-container">
                <div class="archive-divider text-muted fw-bold text-uppercase small" style="letter-spacing: 2px;">
                    📦 Архівні об'єкти
                </div>
            </div>
        }

        var isInactive = !cinema.Isactive;
        var cardClass = isInactive ? "cinema-inactive" : "";

        <div class="col">
            <div class="card h-100 shadow-sm border-0 @cardClass" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold d-inline">@cinema.Name</h5>
                        @if (isInactive) { <span class="badge bg-secondary status-badge">Архів</span> }
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-controller="Halls" asp-action="Create" asp-route-cinemaId="@cinema.Id" 
                           class="btn btn-sm btn-outline-success @(isInactive ? "disabled" : "")">+ залу</a>
                    
                        <a asp-action="Edit" asp-route-id="@cinema.Id" 
                           class="btn btn-sm btn-outline-primary @(isInactive ? "disabled" : "")">✏️</a>
                    
                        @* КНОПКА АРХІВУВАННЯ КІНОТЕАТРУ *@
                        <button type="button" class="btn btn-sm btn-outline-secondary" 
                                data-bs-toggle="modal" 
                                data-bs-target="#archiveCinemaModal" 
                                data-id="@cinema.Id" 
                                data-name="@cinema.Name" 
                                data-isactive="@cinema.Isactive.ToString().ToLower()">
                            <span>@(cinema.Isactive ? "📥" : "📤")</span>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3"><strong>@cinema.City</strong>, @cinema.Address</p>
                    <h6 class="small fw-bold text-uppercase text-secondary mb-2">Зали:</h6>
                    <div class="list-group list-group-flush">
                        @foreach (var hall in cinema.Halls.Where(h => h.Isactive))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 bg-transparent">
                                <span class="small">@hall.Name</span>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Halls" asp-action="Details" asp-route-id="@hall.Id" class="btn btn-sm btn-outline-secondary @(isInactive ? "disabled" : "")">👁️</a>
                                    <a asp-controller="Halls" asp-action="Edit" asp-route-id="@hall.Id" 

                                       class="btn btn-sm btn-outline-primary w-32 @(isInactive ? "disabled" : "")">✏️</a>
                                    @* КНОПКА АРХІВУВАННЯ ЗАЛУ *@
                                    <button type="button" class="btn btn-sm btn-outline-secondary @(isInactive ? "disabled" : "")" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#archiveHallModal" 
                                            data-id="@hall.Id" 
                                            data-name="@hall.Name" 
                                            data-isactive="true">📥</button>
                                </div>
                            </div>
                            }

                            @{ var archivedHalls = cinema.Halls.Where(h => !h.Isactive).ToList(); }
                            @if (archivedHalls.Any())
                            {
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted" 
                                            type="button" data-bs-toggle="collapse" 
                                            data-bs-target="#archivedHalls-@cinema.Id">
                                        <small>📦 Показати архівні зали (@archivedHalls.Count)</small>
                                    </button>
                                
                                    <div class="collapse" id="archivedHalls-@cinema.Id">
                                        @foreach (var hall in archivedHalls)
                                        {
                                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 bg-transparent border-0 opacity-75">
                                                <span class="small text-muted text-decoration-line-through">@hall.Name</span>
                                                <form asp-controller="Halls" asp-action="ArchiveHall" asp-route-id="@hall.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="btn btn-sm btn-link p-0 text-success @(isInactive ? "disabled" : "")" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#archiveHallModal" 
                                                        data-id="@hall.Id" 
                                                        data-name="@hall.Name" 
                                                        data-isactive="false"
                                                        title="Відновити">📤</button>
                                                </form>
                                            </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</div>

@* МОДАЛКА КІНОТЕАТРУ *@
<div class="modal fade" id="archiveCinemaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="modal-title fw-bold" id="archiveModalTitle"></h5></div>
            <div class="modal-body text-center py-4">
                <div id="archiveModalIcon" style="font-size: 3rem;" class="mb-3"></div>
                <p id="archiveModalText" class="fs-5"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <form id="archiveCinemaForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="archiveConfirmBtn" class="btn px-4 shadow-sm"></button>
                </form>
                <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Скасувати</button>
            </div>
        </div>
    </div>
</div>

@* МОДАЛКА ЗАЛУ *@
<div class="modal fade" id="archiveHallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center py-4">
                <div id="hallIcon" style="font-size: 2.5rem;" class="mb-2"></div>
                <h6 class="fw-bold mb-2" id="hallTitle"></h6>
                <p id="hallText" class="small text-muted mb-3"></p>
                <form id="archiveHallForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" id="hallConfirmBtn" class="btn btn-sm px-4 shadow-sm"></button>
                        <button type="button" class="btn btn-sm btn-light border px-4" data-bs-dismiss="modal">Назад</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Логіка для кінотеатру
        const archiveCinemaModal = document.getElementById('archiveCinemaModal');
        archiveCinemaModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const isActive = button.getAttribute('data-isactive') === "true";
            
            const form = document.getElementById('archiveCinemaForm');
            // ВАЖЛИВО: додаємо /Admin/
            form.action = '/Admin/Cinemas/Archive/' + id;
            
            document.getElementById('archiveModalTitle').innerText = isActive ? "Архівувати кінотеатр" : "Відновити кінотеатр";
            document.getElementById('archiveModalText').innerHTML = isActive 
                ? `Ви впевнені, що хочете архівувати <strong>${name}</strong>?` 
                : `Відновити роботу кінотеатру <strong>${name}</strong>?`;
            document.getElementById('archiveModalIcon').innerText = isActive ? "📥" : "📤";
            
            const btn = document.getElementById('archiveConfirmBtn');
            btn.innerText = isActive ? "Архівувати" : "Відновити";
            btn.className = isActive ? "btn btn-secondary px-4" : "btn btn-success px-4";
        });

        // Логіка для залу
        const archiveHallModal = document.getElementById('archiveHallModal');
        archiveHallModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const isActive = button.getAttribute('data-isactive') === "true";
            
            const form = document.getElementById('archiveHallForm');
            // ВАЖЛИВО: шлях до контролера Halls
            form.action = '/Admin/Halls/ArchiveHall/' + id;
            
            document.getElementById('hallTitle').innerText = isActive ? "Архівувати зал" : "Відновити зал";
            document.getElementById('hallText').innerText = name;
            document.getElementById('hallIcon').innerText = isActive ? "📥" : "📤";
            
            const btn = document.getElementById('hallConfirmBtn');
            btn.innerText = isActive ? "В архів" : "Відновити";
            btn.className = isActive ? "btn btn-secondary btn-sm" : "btn btn-success btn-sm";
        });
    });
    </script>
}

<style>
    .cinema-inactive {
        background-color: #f8f9fa !important;
        opacity: 0.65;
        filter: grayscale(80%);
        border: 1px dashed #dee2e6 !important;
    }
    .status-badge {
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        vertical-align: middle;
        margin-left: 5px;
    }
    .hall-archived {
        text-decoration: line-through;
        color: #adb5bd;
    }
    .archive-divider-container {
        flex: 0 0 100%;
        width: 100%;
    }
    .archive-divider {
        display: flex;
        align-items: center;
        text-align: center;
        width: 100%;
        margin: 3rem 0 2rem 0;
    }
    .archive-divider::before, .archive-divider::after {
        content: '';
        flex: 1;
        border-bottom: 2px solid #dee2e6;
    }
    .archive-divider:not(:empty)::before { margin-right: 1.5rem; }
    .archive-divider:not(:empty)::after { margin-left: 1.5rem; }
</style>