@model IEnumerable<Pricecategory>

@{
    ViewData["Title"] = "Цінові категорії";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">💸 Цінові категорії</h1>
            <p class="text-muted small mb-0">Перелік доступних тарифів для квитків</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg me-1"></i> Додати категорію
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center border py-5 shadow-sm">
            <i class="bi bi-currency-dollar display-4 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">Категорій цін поки не створено.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var category in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center py-3">
                            <div class="bg-success bg-opacity-10 p-2 rounded-circle me-3">
                                <i class="bi bi-cash text-success"></i>
                            </div>
                            <strong class="text-dark">@category.Name</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Легкий ефект при наведенні для інтерактивності */
    .card {
        transition: transform 0.2s ease;
    }

    .card:hover {
        transform: translateY(-3px);
    }
</style>