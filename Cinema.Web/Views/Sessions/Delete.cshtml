@model Cinema.Infrastructure.Entities.Session

@{
    ViewData["Title"] = "Видалити сеанс";
}

<div class="container mt-4">
    <h2 class="text-danger">Видалити сеанс</h2>
    <hr />

    <div class="card shadow-sm p-3">
        <h5>Ви впевнені, що хочете видалити цей сеанс?</h5>
        <p><strong>Фільм:</strong> @Model.Movie?.Title</p>
        <p><strong>Зал:</strong> @Model.Hall?.Name</p>
        <p><strong>Час:</strong> @Model.Starttime</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Видалити</button>
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
        </form>
    </div>
</div>
