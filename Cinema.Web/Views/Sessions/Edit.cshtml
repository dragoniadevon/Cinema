@model Cinema.Web.Models.Sessions.EditSessionViewModel
@using Cinema.Infrastructure.Entities.Enums

@{
    ViewData["Title"] = "✏️ Редагувати сеанс";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">

        <h1 class="mb-4 text-center">✏️ Редагувати сеанс</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Фільм</label>
                            <select asp-for="MovieId" class="form-select js-movie-select">
                                @foreach (var movie in (List<Cinema.Infrastructure.Entities.Movie>)ViewBag.Movies)
                                {
                                    <option value="@movie.Id">@movie.Title</option>
                                }
                            </select>
                            <span asp-validation-for="MovieId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Кінотеатр</label>
                            <select id="cinemaSelect" class="form-select">
                                @foreach (var cinema in ViewBag.Cinemas)
                                {
                                    <option value="@cinema.Id">@cinema.DisplayName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Зал</label>
                            <select asp-for="HallId" id="hallSelect" class="form-select">
                                @foreach (var hall in (List<Cinema.Infrastructure.Entities.Hall>)ViewBag.Halls)
                                {
                                    <option value="@hall.Id" data-hall-type="@hall.Halltype" 
                                            selected="@(hall.Id == Model.HallId)">
                                        @hall.Name
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="HallId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Час початку</label>
                            <input asp-for="StartTime"
                                   type="datetime-local"
                                   class="form-control"
                                   value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Формат</label>
                            <select asp-for="Format"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<SessionFormat>()">
                            </select>
                            <span asp-validation-for="Format" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    @{
                        var categories = (List<Cinema.Infrastructure.Entities.Pricecategory>)ViewBag.PriceCategories;
                    }

                    <h5 class="mb-3 text-primary">💰 Ціни на квитки</h5>

                    <div class="p-3 bg-light rounded border">
                        @for (int i = 0; i < categories.Count; i++)
                        {
                            var category = categories[i];
                            decimal currentPrice = Model.CategoryPrices.Length > i ? Model.CategoryPrices[i] : 0;

                            <div class="row mb-3 price-row align-items-center" data-category="@category.Name">
                                <div class="col-sm-5">
                                    <label class="form-label mb-0">@category.Name</label>
                                    <input type="hidden" name="PriceCategoryIds[@i]" value="@category.Id" />
                                </div>
                                <div class="col-sm-7">
                                    <div class="input-group">
                                        <input name="CategoryPrices[@i]" 
                                               class="form-control price-input text-end" 
                                               type="number" 
                                               step="1" 
                                               min="0"
                                               inputmode="numeric"
                                               value="@((int)currentPrice)" />
                                        <span class="input-group-text">грн</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>


                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Зберегти</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
