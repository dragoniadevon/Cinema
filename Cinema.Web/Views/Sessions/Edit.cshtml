@model Cinema.Infrastructure.Entities.Session

<h2>Редагувати сеанс</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <label>Фільм</label>
    <select asp-for="Movieid" class="form-control">
        @foreach (var movie in ViewBag.Movies)
        {
            <option value="@movie.Id">@movie.Title</option>
        }
    </select>

    <label>Зал</label>
    <select asp-for="Hallid" class="form-control">
        @foreach (var hall in ViewBag.Halls)
        {
            <option value="@hall.Id">@hall.Name</option>
        }
    </select>

    <label>Час початку</label>
    <input asp-for="Starttime" type="datetime-local" class="form-control" />

    <button type="submit" class="btn btn-primary mt-3">Зберегти</button>
</form>
