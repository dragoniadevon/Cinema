@model IEnumerable<global::Cinema.Web.Models.Sessions.SessionsByDateVm>
@{
    ViewData["Title"] = "Розклад сеансів";
    // Тепер SelectedDate ніколи не порожній (приходить з контролера)
    var selectedDateStr = ViewBag.SelectedDate as string;
    var availableDates = (List<DateTime>)ViewBag.AllAvailableDates ?? new List<DateTime>();
}

<div class="container mt-4">
    <div class="mb-5 text-center">
        <h1 class="fw-bold display-5">🗓️ Розклад сеансів</h1>
        <p class="text-muted">Оберіть зручний час для перегляду</p>
    </div>

    <div class="mx-auto mb-5" style="max-width: 700px;">
        <div class="d-flex flex-wrap align-items-center bg-white p-2 rounded-4 shadow-sm border justify-content-center gap-2">
            
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                @foreach (var date in availableDates.Take(7))
                {
                    var dateValue = date.ToString("yyyy-MM-dd");
                    var isActive = selectedDateStr == dateValue;
                    
                    <a href="@Url.Action("Index", "Sessions", new { date = dateValue, cinemaId = ViewBag.SelectedCinemaId })" 
                       class="btn @(isActive ? "btn-primary shadow-sm" : "btn-light text-dark border-0") rounded-3 px-3 d-flex flex-column align-items-center justify-content-center"
                       style="min-width: 70px; height: 50px; transition: 0.2s;">
                        <span class="text-uppercase mb-1 fw-bolder" style="font-size: 0.55rem; opacity: 0.7;">
                            @(date.Date == DateTime.Today ? "Сьогодні" : date.ToString("ddd"))
                        </span>
                        <span class="fw-bold" style="font-size: 0.9rem;">@date.ToString("dd.MM")</span>
                    </a>
                }
            </div>

            @if (availableDates.Count > 7)
            {
                var moreDates = availableDates.Skip(7).ToList();
                var selectedInMore = moreDates.FirstOrDefault(d => d.ToString("yyyy-MM-dd") == selectedDateStr);
                var isMoreActive = selectedInMore != default(DateTime);

                <div class="dropdown">
                    <button class="btn @(isMoreActive ? "btn-primary shadow-sm" : "btn-outline-secondary") dropdown-toggle rounded-3 fw-bold d-flex flex-column align-items-center justify-content-center" 
                            type="button" data-bs-toggle="dropdown" style="height: 50px; min-width: 80px;">
                        @if (isMoreActive) {
                            <span class="text-uppercase mb-1 fw-bolder" style="font-size: 0.55rem;">@selectedInMore.ToString("ddd")</span>
                            <span class="fw-bold" style="font-size: 0.9rem;">@selectedInMore.ToString("dd.MM")</span>
                        } else {
                            <span>Ще</span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var date in moreDates) {
                            var dateValue = date.ToString("yyyy-MM-dd");
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center @(selectedDateStr == dateValue ? "active bg-primary text-white" : "")" 
                                   href="@Url.Action("Index", "Sessions", new { date = dateValue, cinemaId = ViewBag.SelectedCinemaId })">
                                   <i class="bi bi-calendar-check me-2"></i>
                                   <div>
                                       <div class="fw-bold">@date.ToString("dd MMMM")</div>
                                       <div class="small opacity-75">@date.ToString("dddd")</div>
                                   </div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    @if (!Model.Any()) {
        <div class="text-center py-5">
            <h4 class="text-muted">На сьогодні сеансів більше немає 🍿</h4>
            <p class="small text-muted">Спробуйте обрати іншу дату зверху</p>
        </div>
    }

    @foreach (var dateGroup in Model)
    {
        <div class="mb-4 mt-5">
            <h3 class="fw-bold text-dark border-bottom pb-3 mb-4">
                <span class="text-primary me-2">📅</span>@dateGroup.Date.ToString("dd MMMM yyyy, dddd")
            </h3>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var movieGroup in dateGroup.Cinemas.SelectMany(c => c.Movies).GroupBy(m => m.Title))
            {
                var movie = movieGroup.First();
                var posterUrl = movie.Sessions.FirstOrDefault()?.Movie?.Posterurl;
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm border-bottom border-primary border-3" style="border-radius: 20px; overflow: hidden;">
                        <div class="row g-0 h-100">
                            <div class="col-5">
                                <img src="@(string.IsNullOrEmpty(posterUrl) ? "/images/no-poster.png" : posterUrl)" class="w-100 h-100 object-fit-cover" style="min-height: 180px;">
                            </div>
                            <div class="col-7">
                                <div class="card-body d-flex flex-column h-100 p-3">
                                    <h6 class="card-title fw-bold text-dark mb-1">@movie.Title</h6>
                                    <p class="small text-muted mb-3"><i class="bi bi-clock me-1"></i>@movie.Duration хв.</p>
                                    <div class="mt-auto">
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var session in movieGroup.SelectMany(m => m.Sessions).OrderBy(s => s.Starttime)) {
                                                <a asp-action="Details" asp-route-id="@session.Id" 
                                                   class="btn btn-sm btn-outline-dark rounded-3 px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                                                    @session.Starttime.ToString("HH:mm")
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>