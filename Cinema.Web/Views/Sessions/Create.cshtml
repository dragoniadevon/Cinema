@model Cinema.Web.Models.Sessions.CreateSessionViewModel
@using Cinema.Infrastructure.Entities.Enums

@{
    ViewData["Title"] = "Додати сеанс";
}

<div class="container mt-4">
    <h2>Додати сеанс</h2>
    <hr />

    <form asp-action="Create" method="post" id="createSessionForm">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- ФІЛЬМ -->
        <div class="mb-3">
            <label class="form-label">Фільм</label>
            <select asp-for="MovieId" class="form-select js-movie-select" required>
                <option value="">— Оберіть фільм —</option>
                @foreach (var movie in ViewBag.Movies)
                {
                    <option value="@movie.Id">@movie.Title</option>
                }
            </select>
            <span asp-validation-for="MovieId" class="text-danger"></span>
        </div>

        <!-- КІНОТЕАТР -->
        <div class="mb-3">
            <label class="form-label">Кінотеатр</label>
            <select asp-for="CinemaId" id="cinemaSelect" class="form-select" required>
                <option value="">— Оберіть кінотеатр —</option>
                @foreach (var cinema in ViewBag.Cinemas)
                {
                    <option value="@cinema.Id">@cinema.Name</option>
                }
            </select>
            <span asp-validation-for="CinemaId" class="text-danger"></span>
        </div>

        <!-- ЗАЛ -->
        <div class="mb-3">
            <label class="form-label">Зал</label>
            <select asp-for="HallId" id="hallSelect" class="form-select" required>
                <option value="">— Спочатку оберіть кінотеатр —</option>
            </select>
            <span asp-validation-for="HallId" class="text-danger"></span>
        </div>

        <!-- ЧАС -->
        <div class="mb-3">
            <label class="form-label">Час початку</label>
            <input asp-for="StartTime" type="datetime-local" class="form-control" required
                value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <!-- ФОРМАТ -->
        <div class="mb-3">
            <label class="form-label">Формат</label>
            <select asp-for="Format" class="form-select" asp-items="Html.GetEnumSelectList<SessionFormat>()" required>
            </select>
            <span asp-validation-for="Format" class="text-danger"></span>
        </div>

        <!-- ЦІНИ -->
        <h5 class="mt-4">Ціни на квитки</h5>

        @for (int i = 0; i < Model.Prices.Count; i++)
        {
            <div class="row mb-2 price-row" data-category="@Model.Prices[i].CategoryName" style="display:none">

                <div class="col-md-4">
                    <label class="form-label">@Model.Prices[i].CategoryName</label>
                    <input type="hidden" asp-for="Prices[i].PriceCategoryId" />
                    <input type="hidden" asp-for="Prices[i].CategoryName" />
                </div>

                <div class="col-md-4">
                    <input asp-for="Prices[i].Price" class="form-control price-input" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Prices[i].Price" class="text-danger"></span>
                </div>
            </div>
        }

        <div class="mt-4">
            <button type="submit" class="btn btn-success" id="submitBtn">
                Зберегти
            </button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            $('.js-movie-select').select2({
                placeholder: 'Почніть вводити назву фільму',
                allowClear: true,
                width: '100%'
            });
        });
    </script>

    <script>
        const hallSelect = document.getElementById("hallSelect");
        const submitBtn = document.getElementById("submitBtn");

        document.getElementById("cinemaSelect").addEventListener("change", function () {
            const cinemaId = this.value;

            hallSelect.disabled = true;
            submitBtn.disabled = true;
            hallSelect.innerHTML = '<option>Завантаження...</option>';

            if (!cinemaId) {
                hallSelect.innerHTML = '<option>— Спочатку оберіть кінотеатр —</option>';
                return;
            }

            fetch(`/Sessions/GetHallsByCinema?cinemaId=${cinemaId}`)
                .then(r => r.json())
                .then(data => {
                    hallSelect.disabled = false;
                    hallSelect.innerHTML = '<option value="">— Оберіть зал —</option>';

                    data.forEach(h => {
                        hallSelect.innerHTML +=
                            `<option value="${h.id}" data-hall-type="${h.halltype}">
                                                    ${h.name}
                                                 </option>`;
                    });
                });
        });
    </script>

    <script>
        function validatePricesAndToggleSubmit() {
            const visibleRows = [...document.querySelectorAll(".price-row")]
                .filter(r => r.style.display !== "none");

            if (visibleRows.length === 0) {
                submitBtn.disabled = true;
                return;
            }

            let allValid = true;

            visibleRows.forEach(row => {
                const input = row.querySelector("input[type=number]");
                const value = parseFloat(input.value);

                if (isNaN(value) || value <= 0) {
                    allValid = false;
                }
            });

            // 🔥 ОЦЕГО РЯДКА НЕ ВИСТАЧАЛО
            submitBtn.disabled = !allValid;
        }


        hallSelect.addEventListener("change", function () {
            submitBtn.disabled = false;
            const selected = this.options[this.selectedIndex];
            const hallType = parseInt(selected?.dataset?.hallType);

            document.querySelectorAll(".price-row").forEach(row => {
                const category = row.dataset.category;
                let show = false;

                if (hallType === 1) show = category === "Standard";
                if (hallType === 2) show = category === "VIP";
                if (hallType === 3) show = category === "Standard" || category === "VIP";

                row.style.display = show ? "flex" : "none";

                if (!show) {
                    row.querySelector("input[type=number]").value = "";
                }
            });

            validatePricesAndToggleSubmit();
        });

        document.querySelectorAll(".price-input").forEach(input => {
            input.addEventListener("input", validatePricesAndToggleSubmit);
        });
    </script>
}