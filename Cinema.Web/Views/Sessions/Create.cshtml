@model Cinema.Web.Models.Sessions.CreateSessionViewModel
@using Cinema.Infrastructure.Entities.Enums

@{
    ViewData["Title"] = "➕ Додати сеанс";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        
        <h1 class="mb-4 text-center">➕ Додати новий сеанс</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="createSessionForm">
                    @Html.AntiForgeryToken()
                    
                    @* Використовуємо ValidationSummary як у кінотеатрі *@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Фільм</label>
                            <select asp-for="MovieId" class="form-select js-movie-select" required>
                                <option value="">— Почніть вводити назву фільму —</option>
                                @foreach (var movie in ViewBag.Movies)
                                {
                                    <option value="@movie.Id">@movie.Title</option>
                                }
                            </select>
                            <span asp-validation-for="MovieId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Кінотеатр</label>
                            <select asp-for="CinemaId" id="cinemaSelect" class="form-select" required>
                                <option value="">— Оберіть кінотеатр —</option>
                                @foreach (var cinema in ViewBag.Cinemas)
                                {
                                    <option value="@cinema.Id">@(cinema.Name) (@(cinema.City))</option>
                                }
                            </select>
                            <span asp-validation-for="CinemaId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Зал</label>
                            <select asp-for="HallId" id="hallSelect" class="form-select" required>
                                <option value="">— Спочатку оберіть кінотеатр —</option>
                            </select>
                            <span asp-validation-for="HallId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Час початку</label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control" required
                                   value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Формат</label>
                            <select asp-for="Format" class="form-select" asp-items="Html.GetEnumSelectList<SessionFormat>()" required>
                            </select>
                            <span asp-validation-for="Format" class="text-danger"></span>
                        </div>

                        @* Вставте це перед блоком цін *@
                        <div class="mb-4">
                            <div class="form-check form-switch p-3 bg-light rounded border shadow-sm">
                                <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="RepeatDaily" id="repeatSwitch">
                                <label class="form-check-label fw-bold" for="repeatSwitch">
                                    🔁 Повторювати цей розклад щодня на наступні 7 днів
                                </label>
                                <div class="small text-muted ms-5">Це автоматично створить окремі сеанси на той самий час для кожного дня тижня.</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3 text-primary"><i class="bi bi-cash-stack"></i> Ціни на квитки</h5>

                    <div id="pricesContainer" class="p-3 bg-light rounded border mb-4">
                        @for (int i = 0; i < Model.Prices.Count; i++)
                        {
                            <div class="row mb-3 price-row align-items-center" data-category="@Model.Prices[i].CategoryName" style="display:none">
                                <div class="col-sm-5">
                                    <label class="form-label mb-0">@Model.Prices[i].CategoryName</label>
                                    <input type="hidden" asp-for="Prices[i].PriceCategoryId" />
                                    <input type="hidden" asp-for="Prices[i].CategoryName" />
                                </div>

                                <div class="col-sm-7">
                                    <div class="input-group">
                                        <input asp-for="Prices[i].Price" class="form-control price-input text-end" 
                                               type="text" 
                                               inputmode="decimal" 
                                               pattern="[0-9]*[.,]?[0-9]+" 
                                               placeholder="0.00" />
                                        <span class="input-group-text">грн</span>
                                    </div>
                                    <span asp-validation-for="Prices[i].Price" class="text-danger"></span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4" id="submitBtn">Зберегти</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Скасувати</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const hallSelect = document.getElementById("hallSelect");
        const cinemaSelect = document.getElementById("cinemaSelect");
        const submitBtn = document.getElementById("submitBtn");

        function updatePriceVisibility() {
            const selected = hallSelect.options[hallSelect.selectedIndex];
            const hallType = parseInt(selected?.dataset?.hallType);

            if (!hallType) {
                document.querySelectorAll(".price-row").forEach(r => r.style.display = "none");
                return;
            }

            document.querySelectorAll(".price-row").forEach(row => {
                const category = row.dataset.category;
                let show = false;

                if (hallType === 1) show = (category === "Standard");
                else if (hallType === 2) show = (category === "VIP");
                else if (hallType === 3) show = (category === "Standard" || category === "VIP");

                row.style.display = show ? "flex" : "none";
            });
            
            validatePrices();
        }

        function validatePrices() {
            const visibleInputs = [...document.querySelectorAll(".price-row")]
                .filter(row => row.style.display === "flex")
                .map(row => row.querySelector(".price-input"));

            if (visibleInputs.length === 0) {
                submitBtn.disabled = (hallSelect.value !== "");
                return;
            }

            let allValid = visibleInputs.every(input => {
                const val = parseFloat(input.value.replace(',', '.'));
                return !isNaN(val) && val > 0;
            });

            submitBtn.disabled = (hallSelect.value === "") || !allValid;
        }

        cinemaSelect.addEventListener("change", function () {
            const cinemaId = this.value;
            hallSelect.disabled = true;
            submitBtn.disabled = true;
            hallSelect.innerHTML = '<option value="">Завантаження...</option>';

            fetch(`/Sessions/GetHallsByCinema?cinemaId=${cinemaId}`)
                .then(r => r.json())
                .then(data => {
                    hallSelect.disabled = false;
                    hallSelect.innerHTML = '<option value="">— Оберіть зал —</option>';
                    data.forEach(h => {
                        hallSelect.innerHTML += `<option value="${h.id}" data-hall-type="${h.halltype}">${h.name}</option>`;
                    });
                    updatePriceVisibility();
                });
        });

        hallSelect.addEventListener("change", updatePriceVisibility);
        document.querySelectorAll(".price-input").forEach(input => {
            input.addEventListener("input", validatePrices);
        });

        $(document).ready(function() {
            if (typeof $.fn.select2 !== 'undefined') {
                $('.js-movie-select').select2({ width: '100%' });
            }
            
            if (hallSelect.value) {
                updatePriceVisibility();
            }
        });
    </script>
}