@model Cinema.Infrastructure.Entities.Session

@{
    ViewData["Title"] = "Додати сеанс";
}

<div class="container mt-4">
    <h2>Додати сеанс</h2>
    <hr />

    <form asp-action="Create">
        <div class="mb-3">
            <label>Фільм</label>
            <select asp-for="Movieid" class="form-control">
                <option value="">-- Оберіть фільм --</option>
                @foreach (var movie in ViewBag.Movies)
                {
                    <option value="@movie.Id">@movie.Title</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Кінотеатр</label>
            <select id="cinemaSelect" class="form-control">
                <option value="">-- Оберіть кінотеатр --</option>
                @foreach (var cinema in ViewBag.Cinemas)
                {
                    <option value="@cinema.Id">@cinema.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Зал</label>
            <select asp-for="Hallid" id="hallSelect" class="form-control">
                <option value="">-- Спочатку оберіть кінотеатр --</option>
            </select>
        </div>

        <div class="mb-3">
            <label>Час початку</label>
            <input asp-for="Starttime" type="datetime-local" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Ціна</label>
            <input asp-for="Sessionprices" id="priceInput" class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-success">Зберегти</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById("cinemaSelect").addEventListener("change", function () {
        let cinemaId = this.value;
        let hallSelect = document.getElementById("hallSelect");

        hallSelect.innerHTML = '<option>Завантаження...</option>';

        fetch('/Sessions/GetHallsByCinema?cinemaId=' + cinemaId)
            .then(res => res.json())
            .then(data => {
                hallSelect.innerHTML = '<option value="">-- Оберіть зал --</option>';
                data.forEach(hall => {
    hallSelect.innerHTML += `<option value="${hall.id}" data-type="${hall.halltype}">${hall.name}</option>`;
});

            });
    });

    document.getElementById("hallSelect").addEventListener("change", function () {
        let selected = this.options[this.selectedIndex];
        let type = selected.getAttribute("data-type");

if (type == 2) priceInput.value = 180; // 3D
