@model SessionDetailsVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.MovieTitle;
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">🗓 До розкладу</a>
    </div>

    <h2 class="mb-4">🎬 @Model.MovieTitle</h2>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">ℹ️ Деталі сеансу</h5>
                    <p><b>Кінотеатр:</b> @Model.CinemaName</p>
                    <p><b>Зал:</b> @Model.HallName</p>
                    <p><b>Початок:</b> @Model.StartTime.ToString("dd.MM HH:mm")</p>
                    <hr />
                    <h6>💸 Вартість:</h6>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var p in Model.Prices) {
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>@p.CategoryName</span>
                                <span class="fw-bold text-success">@p.Price ₴</span>
                            </li>
                        }
                    </ul>
                    <a asp-controller="Tickets" asp-action="Book" asp-route-sessionId="@Model.SessionId" class="btn btn-success w-100 py-2">
                        Придбати квитки 🎟
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="mb-4">Схема залу</h5>
                    <div class="fw-bold mb-4 border-bottom pb-2 mx-5">ЕКРАН</div>
                    
                    <div class="w-100" style="overflow-x:auto;">
                        <div style="min-width: 620px; display:flex; flex-direction:column; gap:12px; align-items:center;">
                            @for (int r = 1; r <= Model.Rows; r++) {
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div class="small text-muted" style="width:40px;">@r</div>
                                    @for (int n = 1; n <= Model.SeatsPerRow; n++) {
                                        var seat = Model.Seats.FirstOrDefault(x => x.Row == r && x.Number == n);
                                        if (seat != null) {
                                            <button type="button" @(seat.IsTaken ? "disabled" : "") 
                                                    class="btn btn-sm @(seat.IsTaken ? "btn-secondary opacity-50" : "btn-outline-dark")"
                                                    style="width:38px; height:32px; font-size: 12px;">@n</button>
                                        }
                                    }
                                    <div class="small text-muted" style="width:40px;">@r</div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mt-4 small text-muted text-center border-top pt-3">
                        ⚪️ Оберіть вільне місце для переходу до оплати
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>