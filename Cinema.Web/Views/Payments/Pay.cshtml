@model PaymentVm

@{
    ViewData["Title"] = "Оплата квитків";
}

<div class="container mt-4">

    <div class="mb-3 d-flex gap-2 flex-wrap">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">
            ⬅️ До профілю
        </a>

        <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline-dark">
            🗓 До сеансів
        </a>
    </div>

    <h2 class="mb-4">Оплата квитків 💳</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-warning fw-bold mb-4">
        ⏱ Залишилось часу для оплати: @Model.MinutesLeft хв
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <ul class="list-group list-group-flush">
                @foreach (var ticket in Model.Tickets)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            🎬 <b>@ticket.MovieTitle</b><br />
                            Ряд @ticket.Row, Місце @ticket.SeatNumber
                        </span>
                        <span class="fw-bold">@ticket.Price ₴</span>
                    </li>
                }
            </ul>

        </div>
    </div>

    <h4 class="mb-4">
        До оплати:
        <span class="text-success fw-bold">
            @Model.TotalAmount ₴
        </span>
    </h4>

    <form asp-action="Confirm" method="post">
        @Html.AntiForgeryToken()

        @foreach (var ticket in Model.Tickets)
        {
            <input type="hidden" name="ticketIds" value="@ticket.TicketId" />
        }

        <button type="submit" class="btn btn-success btn-lg">
            ПІДТВЕРДИТИ ОПЛАТУ ✅
        </button>
    </form>

</div>