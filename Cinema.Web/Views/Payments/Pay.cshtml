@model PaymentVm

@{
    ViewData["Title"] = "Оплата квитків";
    // Розраховуємо час закінчення броні для JS
    var expiryTime = DateTime.Now.AddMinutes(Model.MinutesLeft).ToString("yyyy-MM-ddTHH:mm:ss");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Кнопки навігації *@
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <a asp-controller="Sessions" asp-action="Index"
                       class="btn btn-link text-decoration-none text-muted p-0">
                    <i class="bi bi-chevron-left"></i> Повернутися до розкладу
                </a>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    Крок 2 з 2: Оплата
                </span>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-4 px-4 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0">Оплата квитків 💳</h3>
                        <div class="text-end">
                            <small class="d-block opacity-75 text-uppercase fw-bold"
                                   style="font-size: 0.7rem;">Залишилось часу</small>
                            <span id="payment-timer" class="fs-4 fw-bold text-warning">--:--</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <h5 class="fw-bold mb-3 text-secondary">Ваше замовлення:</h5>

                    <div class="list-group list-group-flush border rounded-4 mb-4 overflow-hidden">
                        @foreach (var ticket in Model.Tickets)
                        {
                            <div class="list-group-item py-3 px-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-1 text-dark">🎬 @ticket.MovieTitle</h6>
                                        <p class="mb-0 text-muted small">
                                            Ряд <span class="text-dark fw-bold">@ticket.Row</span>,
                                            Місце <span class="text-dark fw-bold">@ticket.SeatNumber</span>
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <span class="fs-5 fw-bold text-dark">@ticket.Price.ToString("N2") ₴</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="bg-light rounded-4 p-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Кількість квитків:</span>
                            <span class="fw-bold">@Model.Tickets.Count шт.</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <span class="fs-4 fw-bold text-dark">Разом до оплати:</span>
                            <span class="fs-2 fw-bold text-success">@Model.TotalAmount.ToString("N2") ₴</span>
                        </div>
                    </div>

                    <form asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()

                        @foreach (var ticket in Model.Tickets)
                        {
                            <input type="hidden" name="ticketIds" value="@ticket.TicketId" />
                        }

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold rounded-4 shadow-sm">
                                ПІДТВЕРДИТИ ТА ОПЛАТИТИ ✅
                            </button>
                            <a asp-controller="Profile" asp-action="Index"
                                   class="btn btn-outline-secondary py-2 border-0 rounded-4">
                                Скасувати та повернутися до профілю
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <p class="text-center text-muted mt-4 small">
                <i class="bi bi-shield-lock-fill"></i> Ваші платежі захищені та безпечні
            </p>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        border-radius: 20px;
    }

    .shadow-lg {
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, .1) !important;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #218838 100%);
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(40, 167, 69, 0.3);
    }

    .list-group-item {
        border-color: #f0f0f0;
    }
</style>

@section Scripts {
    <script>
                    (function () {
                        const expiryDate = new Date("@expiryTime");
                        const timerElement = document.getElementById("payment-timer");

                        function updateTimer() {
                            const now = new Date();
                            const diff = expiryDate - now;

                            if (diff <= 0) {
                                timerElement.innerText = "00:00";
                                timerElement.classList.replace("text-warning", "text-danger");
                                // Можна додати автоматичний редирект, якщо час вийшов
                                alert("Час оплати вичерпано. Ви будете перенаправлені до розкладу.");
                                window.location.href = '@Url.Action("Index", "Sessions")';
                                return;
                            }

                            const m = Math.floor(diff / 60000);
                            const s = Math.floor((diff % 60000) / 1000);
                            timerElement.innerText = `${m}:${s.toString().padStart(2, '0')}`;
                        }

                        updateTimer();
                        setInterval(updateTimer, 1000);
                    })();
    </script>
}