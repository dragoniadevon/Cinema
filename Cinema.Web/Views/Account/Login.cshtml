@model LoginVm

@{
    ViewData["Title"] = "Вхід";
}

<div class="container d-flex flex-column justify-content-center align-items-center flex-grow-1 py-5">
    <div class="card border-0 shadow-sm p-4" style="max-width: 420px; width: 100%; border-radius: 16px;">

        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
                <i class="bi bi-shield-lock-fill text-primary h3 mb-0"></i>
            </div>
            <h2 class="fw-bold">Вітаємо!</h2>
            <p class="text-muted small">Будь ласка, увійдіть у свій акаунт</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-muted">Електронна пошта</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-0 bg-light shadow-none p-2"
                        placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold text-muted">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control border-0 bg-light shadow-none p-2"
                        placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input shadow-none" />
                    <label asp-for="RememberMe" class="form-check-label small text-muted">Запам'ятати мене</label>
                </div>
                @* Тут можна додати посилання "Забули пароль?", якщо воно передбачено *@
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-bold">
                Увійти <i class="bi bi-arrow-right-short ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="small text-muted mb-0">
                Немає акаунта?
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold">
                    Зареєструватися
                </a>
            </p>
        </div>
    </div>
</div>

<style>
    /* Стилізація фокусу для інпутів */
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    }

    .input-group-text {
        border-radius: 10px 0 0 10px !important;
    }

    .form-control {
        border-radius: 0 10px 10px 0 !important;
    }

    .btn-primary {
        border-radius: 10px;
    }
</style>