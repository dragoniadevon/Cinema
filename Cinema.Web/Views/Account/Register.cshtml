@model RegisterVm

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container d-flex flex-column justify-content-center align-items-center flex-grow-1 py-5">
    <div class="card border-0 shadow-sm p-4" style="max-width: 500px; width: 100%; border-radius: 16px;">

        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
                <i class="bi bi-person-plus-fill text-primary h3 mb-0"></i>
            </div>
            <h2 class="fw-bold">Створення акаунта</h2>
            <p class="text-muted small">Приєднуйтесь до нашої спільноти кіноманів</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label small fw-bold text-muted">Ім'я</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-person text-muted"></i>
                        </span>
                        <input asp-for="FirstName" class="form-control border-0 bg-light shadow-none p-2"
                            placeholder="Іван" />
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label small fw-bold text-muted">Прізвище</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-person text-muted"></i>
                        </span>
                        <input asp-for="LastName" class="form-control border-0 bg-light shadow-none p-2"
                            placeholder="Іванов" />
                    </div>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-muted">Електронна пошта</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-0 bg-light shadow-none p-2"
                        placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold text-muted">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control border-0 bg-light shadow-none p-2"
                        placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Підтвердження
                    пароля</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-shield-check text-muted"></i>
                    </span>
                    <input asp-for="ConfirmPassword" type="password"
                        class="form-control border-0 bg-light shadow-none p-2" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-bold">
                Зареєструватися <i class="bi bi-check-circle-fill ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="small text-muted mb-0">
                Вже маєш акаунт?
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">
                    Увійти
                </a>
            </p>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    }

    .input-group-text {
        border-radius: 10px 0 0 10px !important;
    }

    .form-control {
        border-radius: 0 10px 10px 0 !important;
    }

    .btn-primary {
        border-radius: 10px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}