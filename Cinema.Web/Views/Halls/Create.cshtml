@model Hall

@{
    ViewData["Title"] = "➕ Додати новий зал";
}

<h1 class="mb-4">➕ Додати новий зал</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Cinemaid" value="@ViewBag.CinemaId" />
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Назва залу</label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Синій зал" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Halltype" class="form-label">Тип залу</label>
                    <select asp-for="Halltype" id="hallTypeSelect" class="form-select">
                        <option value="@((short)HallType.Standard)">Стандарт</option>
                        <option value="@((short)HallType.VIP)">VIP</option>
                        <option value="@((short)HallType.Mixed)">Змішаний (VIP останній ряд)</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Rows" class="form-label">Кількість рядів</label>
                    <input asp-for="Rows" type="number" class="form-control" min="1" max="50" />
                    <span asp-validation-for="Rows" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Seatsperrow" class="form-label">Місць у звичайному ряду</label>
                    <input asp-for="Seatsperrow" id="standardSeatsInput" type="number" class="form-control" min="1" max="30" />
                    <span asp-validation-for="Seatsperrow" class="text-danger"></span>
                </div>

                <div class="col-md-12" id="vipSeatsContainer" style="display: none;">
                    <div class="p-3 border rounded border-warning bg-light">
                        <label class="form-label fw-bold text-warning">💎 VIP місць в останньому ряду</label>
                        <input name="vipSeats" id="vipSeatsInput" type="number" 
                               class="form-control border-warning" placeholder="Введіть кількість..." />
                        <span class="text-danger" data-valmsg-for="vipSeats"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Створити та згенерувати місця</button>
                <a asp-controller="Cinemas" asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

<script>
    const hallTypeSelect = document.getElementById('hallTypeSelect');
    const vipContainer = document.getElementById('vipSeatsContainer');
    const standardInput = document.getElementById('standardSeatsInput');
    const vipInput = document.getElementById('vipSeatsInput');

    function updateVipUI() {
        if (hallTypeSelect.value == "3") {
            vipContainer.style.display = 'block';
            vipInput.required = true;
        } else {
            vipContainer.style.display = 'none';
            vipInput.required = false;
            vipInput.value = "";
        }

        const maxVal = standardInput.value || 0;
        vipInput.max = maxVal;
    }

    hallTypeSelect.addEventListener('change', updateVipUI);
    standardInput.addEventListener('input', updateVipUI);
    updateVipUI();
</script>