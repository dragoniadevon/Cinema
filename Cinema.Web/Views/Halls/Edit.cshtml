@model Cinema.Infrastructure.Entities.Hall
@using Cinema.Infrastructure.Entities.Enums

@{
    ViewData["Title"] = "✏️ Редагувати зал";
}

<h1 class="mb-4">✏️ Редагувати зал: @Model.Name</h1>
<div asp-validation-summary="All" class="text-danger mb-4"></div>

<div class="alert alert-warning shadow-sm mb-4">
    <i class="bi bi-exclamation-triangle-fill"></i> 
    <strong>Увага!</strong> Будь-яка зміна кількості рядів або місць призведе до повної перегенерації схеми місць.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Cinemaid" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Назва залу</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Halltype" class="form-label">Тип залу</label>
                    <select asp-for="Halltype" id="editHallType" class="form-select">
                        <option value="@((short)HallType.Standard)">Стандарт</option>
                        <option value="@((short)HallType.VIP)">VIP</option>
                        <option value="@((short)HallType.Mixed)">Змішаний (VIP останній ряд)</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Rows" class="form-label">Кількість рядів</label>
                    <input asp-for="Rows" type="number" class="form-control" min="1" max="50" />
                    <span asp-validation-for="Rows" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Seatsperrow" class="form-label">Місць у звичайному ряду</label>
                    <input asp-for="Seatsperrow" id="editStandardSeats" type="number" class="form-control" min="1" max="30" />
                    <span asp-validation-for="Seatsperrow" class="text-danger"></span>
                </div>

                <div class="col-md-12" id="editVipContainer" style="display: none;">
                    <div class="p-3 border rounded border-warning bg-light">
                        <label class="form-label fw-bold text-warning">💎 VIP місць в останньому ряду</label>
                        @{
                            var currentVipCount = Model.Seats
                                .Where(s => s.Rownumber == Model.Rows && s.Pricecategoryid == (int)SeatCategory.VIP)
                                .Count();
                            string displayValue = currentVipCount > 0 ? currentVipCount.ToString() : "";
                        }
                        <input name="vipSeats" id="editVipInput" type="number" class="form-control border-warning" placeholder="Введіть кількість..." value="@displayValue" min="1" />
                        <span class="text-danger" data-valmsg-for="vipSeats"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Зберегти та перегенерувати</button>
                <a asp-controller="Cinemas" asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

<script>
    const typeSelect = document.getElementById('editHallType');
    const container = document.getElementById('editVipContainer');
    const vipInput = document.getElementById('editVipInput');
    const stdInput = document.getElementById('editStandardSeats');

    function syncEditUI() {
        if (typeSelect.value == "3") {
            container.style.display = 'block';
            vipInput.removeAttribute('disabled');
        } else {
            container.style.display = 'none';
            vipInput.value = "";
            vipInput.setAttribute('disabled', 'disabled');
        }
        
        vipInput.max = stdInput.value;
    }

    typeSelect.addEventListener('change', syncEditUI);
    stdInput.addEventListener('input', syncEditUI);
    syncEditUI();
</script>