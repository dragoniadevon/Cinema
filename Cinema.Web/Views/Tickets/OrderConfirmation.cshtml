@model OrderConfirmationVm
@using global::Cinema.Infrastructure.Entities.Enums

@{
    ViewData["Title"] = "Замовлення підтверджено";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <div class="display-1 text-success mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="fw-bold">Дякуємо за покупку! 🎉</h1>
        <p class="text-muted fs-5">Ваше замовлення успішно підтверджено. Електронні квитки вже у вашому кабінеті.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h5 class="text-secondary mb-4 text-center text-uppercase letter-spacing-2">Ваші квитки</h5>

            @foreach (var t in Model.Tickets)
            {
                <div class="ticket-confirmed mb-4 shadow-sm border-0">
                    <div class="ticket-body p-0 bg-white position-relative rounded-4 overflow-hidden">
                        @* Декоративні вирізи по боках *@
                        <div class="cutout cutout-left"></div>
                        <div class="cutout cutout-right"></div>

                        <div class="row g-0 align-items-center" style="min-height: 120px;">

                            <div class="col-md-5 p-4">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 small">
                                        <i class="bi bi-check-circle-fill me-1"></i> Оплачено
                                    </span>
                                    <span class="ms-2 text-muted tiny-text fw-bold">#@t.TicketId</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">🎬 @t.MovieTitle
                                    (@if (t.Format != null)
                                    {
                                        @(t.Format == SessionFormat.TwoD ? "2D" : "3D")
                                    })
                                </h5>
                                <p class="text-muted mb-0 small">
                                    <i class="bi bi-geo-alt-fill text-danger"></i> @t.CinemaCity • @t.CinemaName
                                </p>
                            </div>

                            <div
                                class="col-md-4 p-4 bg-light h-100 d-flex flex-column justify-content-center border-start border-end border-dashed border-white">
                                <div class="mb-2">
                                    <small class="text-muted d-block tiny-text fw-bold text-uppercase">Сеанс</small>
                                    <strong class="text-dark">@t.SessionStart.ToString("dd.MM.yyyy HH:mm")</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block tiny-text fw-bold text-uppercase">Ваше місце</small>
                                    <strong class="text-primary">Ряд @t.Row, Місце @t.Seat</strong>
                                </div>
                            </div>

                            <div class="col-md-3 p-4 text-md-end">
                                <div class="barcode-mini ms-auto mb-2 d-none d-md-block"></div>
                                <div class="mt-2">
                                    <small class="text-muted d-block tiny-text fw-bold text-uppercase">Вартість</small>
                                    <h4 class="fw-bold text-dark mb-0">@t.Price.ToString("N2") ₴</h4>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="Profile" asp-action="Index"
                       class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow fw-bold">
                    Переглянути в профілі <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <div class="mt-3">
                    <a asp-controller="Sessions" asp-action="Details" asp-route-id="@Model.SessionId"
                           class="btn btn-link text-muted text-decoration-none">
                        Купити ще квитки
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
    }

    .letter-spacing-2 {
        letter-spacing: 2px;
    }

    .tiny-text {
        font-size: 0.7rem;
    }

    /* Стилізація квитка */
    .ticket-confirmed {
        border-radius: 20px;
        overflow: hidden;
    }

    .ticket-body {
        border-top: 10px solid #198754;
        /* Зелений акцент зверху */
    }

    /* Ефект вирізів по боках */
    .cutout {
        position: absolute;
        width: 30px;
        height: 30px;
        background-color: #f4f7f6;
        /* Має збігатися з фоном body */
        border-radius: 50%;
        top: 50%;
        margin-top: -15px;
        z-index: 2;
    }

    .cutout-left {
        left: -15px;
        box-shadow: inset -5px 0 5px rgba(0, 0, 0, 0.03);
    }

    .cutout-right {
        right: -15px;
        box-shadow: inset 5px 0 5px rgba(0, 0, 0, 0.03);
    }

    /* Пунктирна лінія */
    .border-dashed {
        border-style: dashed !important;
        border-color: #dee2e6 !important;
    }

    /* Імітація штрих-коду */
    .barcode-mini {
        width: 100px;
        height: 35px;
        background: repeating-linear-gradient(90deg, #333, #333 1px, transparent 1px, transparent 3px);
        opacity: 0.5;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        transition: transform 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2) !important;
    }

    .border-dashed {
        border-style: dashed !important;
        border-width: 0 2px 0 2px !important;
        /* Пунктир тільки по боках */
        border-color: #f4f7f6 !important;
    }

    .ticket-body {
        border-top: 8px solid #198754;
    }

    .tiny-text {
        font-size: 0.65rem;
        letter-spacing: 0.5px;
    }

    /* Щоб штрих-код не розтягувався */
    .barcode-mini {
        width: 80px;
        height: 30px;
    }
</style>