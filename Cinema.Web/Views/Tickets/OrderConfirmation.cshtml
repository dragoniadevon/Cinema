@model OrderConfirmationVm

@{
    ViewData["Title"] = "Замовлення підтверджено";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <div class="display-1 text-success mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="fw-bold">Дякуємо за покупку! 🎉</h1>
        <p class="text-muted fs-5">Ваше замовлення успішно підтверджено. Електронні квитки вже у вашому кабінеті.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h5 class="text-secondary mb-4 text-center text-uppercase letter-spacing-2">Ваші квитки</h5>

            @foreach (var t in Model.Tickets)
            {
                <div class="ticket-confirmed mb-4 shadow">
                    <div class="ticket-body p-4 bg-white position-relative">
                        @* Декоративні вирізи *@
                        <div class="cutout cutout-left"></div>
                        <div class="cutout cutout-right"></div>

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@t.MovieTitle</h4>
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                    <i class="bi bi-ticket-perforated me-1"></i> Оплачено
                                </span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">№ квитка</small>
                                <span class="fw-bold text-primary">#@t.TicketId</span>
                            </div>
                        </div>

                        <div class="row g-0 py-3 border-top border-bottom border-dashed my-3">
                            <div class="col-6 border-end text-center">
                                <small class="text-muted d-block text-uppercase fw-bold tiny-text">Ряд</small>
                                <span class="fs-3 fw-bold text-dark">@t.Row</span>
                            </div>
                            <div class="col-6 text-center">
                                <small class="text-muted d-block text-uppercase fw-bold tiny-text">Місце</small>
                                <span class="fs-3 fw-bold text-dark">@t.Seat</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="barcode-mini"></div>
                            <div class="text-end">
                                <small class="text-muted d-block">Ціна</small>
                                <h4 class="fw-bold text-dark mb-0">@t.Price.ToString("N2") ₴</h4>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="Profile" asp-action="Index"
                       class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow fw-bold">
                    Переглянути в профілі <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <div class="mt-3">
                    <a asp-controller="Sessions" asp-action="Index"
                           class="btn btn-link text-muted text-decoration-none">
                        Купити ще квитки
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
    }

    .letter-spacing-2 {
        letter-spacing: 2px;
    }

    .tiny-text {
        font-size: 0.7rem;
    }

    /* Стилізація квитка */
    .ticket-confirmed {
        border-radius: 20px;
        overflow: hidden;
    }

    .ticket-body {
        border-top: 10px solid #198754;
        /* Зелений акцент зверху */
    }

    /* Ефект вирізів по боках */
    .cutout {
        position: absolute;
        width: 30px;
        height: 30px;
        background-color: #f4f7f6;
        /* Має збігатися з фоном body */
        border-radius: 50%;
        top: 50%;
        margin-top: -15px;
        z-index: 2;
    }

    .cutout-left {
        left: -15px;
        box-shadow: inset -5px 0 5px rgba(0, 0, 0, 0.03);
    }

    .cutout-right {
        right: -15px;
        box-shadow: inset 5px 0 5px rgba(0, 0, 0, 0.03);
    }

    /* Пунктирна лінія */
    .border-dashed {
        border-style: dashed !important;
        border-color: #dee2e6 !important;
    }

    /* Імітація штрих-коду */
    .barcode-mini {
        width: 100px;
        height: 35px;
        background: repeating-linear-gradient(90deg, #333, #333 1px, transparent 1px, transparent 3px);
        opacity: 0.5;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        transition: transform 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2) !important;
    }
</style>