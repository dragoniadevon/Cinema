@model BookTicketVm

@{
    ViewData["Title"] = "Вибір місця";
}

<div class="mb-3 d-flex gap-2">
    <a asp-controller="Sessions"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ⬅️ Назад до сеансів
    </a>
</div>

<h2>Вибір місця</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Book" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="SessionId" value="@Model.SessionId" />

    <div style="display:flex; flex-wrap:wrap; gap:8px; max-width:520px;">
        @foreach (var s in Model.Seats)
        {
            if (s.IsTaken)
            {
                <button type="button"
                        disabled
                        style="width:60px;height:40px;opacity:0.5;"
                        class="btn btn-secondary">
                    @s.Row-@s.Number
                </button>
            }
            else
            {
                <button type="submit"
                        name="SeatId"
                        value="@s.SeatId"
                        style="width:60px;height:40px;"
                        class="btn btn-success">
                    @s.Row-@s.Number
                </button>
            }
        }
    </div>
</form>