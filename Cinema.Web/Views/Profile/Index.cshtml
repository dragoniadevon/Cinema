@model ProfileViewModel

@{
    ViewData["Title"] = "Мій кабінет";
}

<div class="container mt-5">
    <div class="row">

        <!-- Блок профілю -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-light text-center fw-bold">
                    👤 Мій профіль
                </div>

                <div class="card-body text-center p-4">
                    @if (TempData["ProfileUpdated"] != null)
                    {
                        <div class="toast-container position-fixed bottom-0 end-0 p-3">
                            <div id="profileToast" class="toast align-items-center text-bg-success border-0" role="alert">
                                <div class="d-flex">
                                    <div class="toast-body">
                                        ✅ Профіль оновлено успішно!
                                    </div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            </div>
                        </div>
                        <script>
                            const toastEl = document.getElementById('profileToast');
                            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                            toast.show();
                        </script>
                    }

                    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- Аватар -->
                        <div class="mb-3">
                            <img src="@(Model.User.AvatarPath ?? "~/images/default-avatar.png")"
                                 class="avatar rounded-circle shadow-sm border border-2 border-primary"
                                 style="object-fit: cover; width: 140px; height: 140px;"
                                 alt="Avatar">
                        </div>

                        <!-- Красива кнопка для завантаження -->
                        <div class="mb-3">
                            <label for="avatarUpload" class="btn btn-outline-primary w-100 fw-bold">
                                ➕ Додати аватар
                            </label>
                            <input type="file" id="avatarUpload" name="Avatar" class="d-none" />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Ім’я</label>
                            <input asp-for="User.FirstName" class="form-control" />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Прізвище</label>
                            <input asp-for="User.LastName" class="form-control" />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Email</label>
                            <input asp-for="User.Email" class="form-control" />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Телефон</label>
                            <input asp-for="User.PhoneNumber" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-outline-secondary w-100">
                            ✏️ Зберегти зміни
                        </button>
                    </form>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100">
                            🚪 Вийти
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Блок квитків -->
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">🎟 Мої квитки</h4>

                    @if (!Model.Tickets.Any())
                    {
                        <div class="alert alert-info text-center">
                            У вас ще немає куплених квитків.
                        </div>
                    }
                    else
                    {
                        <ul class="nav nav-tabs mb-3" id="ticketTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                                    Активні
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="archive-tab" data-bs-toggle="tab" data-bs-target="#archive" type="button" role="tab">
                                    Архівні
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="active" role="tabpanel">
                                @foreach (var ticket in Model.Tickets.Where(t => t.Session.Starttime >= DateTime.Now))
                                {
                                    <div class="card mb-3 shadow-sm">
                                        <div class="card-body">
                                            <h5>@ticket.Session.Movie!.Title</h5>
                                            <p class="text-muted">
                                                📍 @ticket.Session.Hall!.Cinema!.Name • Зал: @ticket.Session.Hall.Name
                                            </p>
                                            <p>🕒 @ticket.Session.Starttime.ToString("dd.MM.yyyy HH:mm")</p>
                                            <p>💺 Ряд @ticket.Seat!.Rownumber, Місце @ticket.Seat.Seatnumber</p>
                                            <p class="fw-bold">💵 @ticket.Price.ToString("C")</p>
                                            <p id="countdown-@ticket.Id" class="text-primary fw-bold"></p>
                                            <script>
                                                (function () {
                                                    const targetDate = new Date("@ticket.Session.Starttime.ToString("yyyy-MM-ddTHH:mm:ss")");
                                                    const countdownElement = document.getElementById("countdown-@ticket.Id");

                                                    function updateCountdown() {
                                                        const now = new Date();
                                                        const diff = targetDate - now;

                                                        if (diff <= 0) {
                                                            countdownElement.innerText = "🎬 Сеанс вже почався!";
                                                            return;
                                                        }

                                                        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                                                        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                                                        const minutes = Math.floor((diff / (1000 * 60)) % 60);

                                                        countdownElement.innerText = `⏳ До початку залишилось: ${days} дн. ${hours} год. ${minutes} хв.`;
                                                    }

                                                    updateCountdown();
                                                    setInterval(updateCountdown, 60000);
                                                })();
                                            </script>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="tab-pane fade" id="archive" role="tabpanel">
                                @foreach (var ticket in Model.Tickets.Where(t => t.Session.Starttime < DateTime.Now))
                                {
                                    <div class="card mb-3 shadow-sm">
                                        <div class="card-body">
                                            <h5>@ticket.Session.Movie!.Title</h5>
                                            <p class="text-muted">
                                                📍 @ticket.Session.Hall!.Cinema!.Name • Зал: @ticket.Session.Hall.Name
                                            </p>
                                            <p>🕒 @ticket.Session.Starttime.ToString("dd.MM.yyyy HH:mm")</p>
                                            <p>💺 Ряд @ticket.Seat!.Rownumber, Місце @ticket.Seat.Seatnumber</p>
                                            <p class="fw-bold">💵 @ticket.Price.ToString("C")</p>
                                            <span class="badge bg-secondary">Минув</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // відкриває діалог вибору файлу при кліку на кнопку
    document.querySelector("label[for='avatarUpload']").addEventListener("click", function () {
        document.getElementById("avatarUpload").click();
    });

    // автоматично відправляє форму після вибору файлу
    document.getElementById("avatarUpload").addEventListener("change", function () {
        this.closest("form").submit();
    });
</script>

<style>
    /* Hover ефект для аватара */
    img.avatar {
        transition: transform 0.3s, box-shadow 0.3s;
    }
    img.avatar:hover {
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.6);
    }

    /* Анімація вкладок */
    .tab-pane {
        transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
    }
    .tab-pane.active {
        opacity: 1;
        transform: translateX(0);
    }
    .tab-pane:not(.active) {
        opacity: 0