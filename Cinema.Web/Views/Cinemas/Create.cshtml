@model Cinema.Infrastructure.Entities.Cinema

@{
    ViewData["Title"] = "➕ Додати кінотеатр";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        
        <h1 class="mb-4 text-center">➕ Додати новий кінотеатр</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="cinemaForm">
                    @Html.AntiForgeryToken()
                    
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold">Назва кінотеатру</label>
                            <input asp-for="Name" id="cinemaName" class="form-control" 
                                   placeholder="Наприклад: Планета Кіно" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-bold">Місто</label>
                            <input asp-for="City" id="cinemaCity" class="form-control" 
                                   placeholder="Наприклад: Луцьк" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-bold">Адреса</label>
                            <input asp-for="Address" id="cinemaAddress" class="form-control" 
                                   placeholder="вул. Соборності, 11" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-start">
                        <button type="submit" id="saveCinemaBtn" class="btn btn-primary px-5 shadow-sm" disabled>
                            Зберегти
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Скасувати
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("cinemaForm");
            const btn = document.getElementById("saveCinemaBtn");
            const inputs = form.querySelectorAll("input[required]");

            function checkInputs() {
                let allFilled = true;
                inputs.forEach(input => {
                    if (input.value.trim() === "") {
                        allFilled = false;
                    }
                });
                btn.disabled = !allFilled;
            }

            form.addEventListener("input", checkInputs);
        });
    </script>
}