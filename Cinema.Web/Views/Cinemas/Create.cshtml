@model Cinema.Infrastructure.Entities.Cinema

@{
    ViewData["Title"] = "➕ Додати кінотеатр";
}

<h1 class="mb-4">➕ Додати кінотеатр</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" id="cinemaForm">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label">Назва кінотеатру</label>
                    <input asp-for="Name" id="cinemaName" class="form-control" placeholder="Наприклад: Планета Кіно" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label">Місто</label>
                    <input asp-for="City" id="cinemaCity" class="form-control" placeholder="Наприклад: Луцьк" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Address" class="form-label">Адреса</label>
                    <input asp-for="Address" id="cinemaAddress" class="form-control" placeholder="вул. Соборності, 11" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                @* Додано id="saveCinemaBtn" та disabled *@
                <button type="submit" id="saveCinemaBtn" class="btn btn-primary" disabled>Зберегти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("cinemaForm");
            const btn = document.getElementById("saveCinemaBtn");
            const inputs = form.querySelectorAll("input[required], input:not([type='hidden'])");

            function checkInputs() {
                let allFilled = true;
                inputs.forEach(input => {
                    if (input.value.trim() === "") {
                        allFilled = false;
                    }
                });
                btn.disabled = !allFilled;
            }

            // Перевіряємо при кожному введенні символу
            form.addEventListener("input", checkInputs);
        });
    </script>
}