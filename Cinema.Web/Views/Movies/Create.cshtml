@using Cinema.Infrastructure.Entities.Enums
@model Cinema.Web.Models.CreateMovieViewModel

@{
    ViewData["Title"] = "➕ Додати фільм";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">

        <h1 class="mb-4 text-center">➕ Додати новий фільм</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3">

                        <!-- 🔹 Основна інформація -->
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Duration" class="form-label fw-bold"></label>
                            <input asp-for="Duration" type="number" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReleaseDate" class="form-label fw-bold"></label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                        </div>

                        <div class="row g-3">

                            <div class="col-md-3">
                                <label asp-for="AgeRating" class="form-label fw-bold small"></label>
                                <select asp-for="AgeRating" asp-items="Html.GetEnumSelectList<AgeRating>()"
                                    class="form-select form-select-sm">
                                    <option value="">—</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Rating" class="form-label fw-bold small"></label>
                                <input asp-for="Rating" step="0.1" class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="LanguageCode" class="form-label fw-bold small"></label>
                                <select asp-for="LanguageCode" asp-items="Html.GetEnumSelectList<LanguageCode>()"
                                    class="form-select form-select-sm">
                                    <option value="">—</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="CountryCode" class="form-label fw-bold small"></label>
                                <select asp-for="CountryCode" asp-items="Html.GetEnumSelectList<CountryCode>()"
                                    class="form-select form-select-sm">
                                    <option value="">—</option>
                                </select>
                            </div>

                        </div>

                        <div class="col-md-6">
                            <label asp-for="PosterUrl" class="form-label fw-bold"></label>
                            <input asp-for="PosterUrl" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TrailerUrl" class="form-label fw-bold"></label>
                            <input asp-for="TrailerUrl" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Жанри</label>
                            <select asp-for="SelectedGenres"
                                asp-items="@(new MultiSelectList(ViewBag.Genres, "Id", "Name"))" multiple
                                id="genres-select" class="form-select">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Актори</label>
                            <select asp-for="SelectedActors"
                                asp-items="@(new MultiSelectList(ViewBag.Actors, "Id", "Fullname"))" multiple
                                id="actors-select" class="form-select">
                            </select>
                        </div>

                    </div>


                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            Зберегти
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Скасувати
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            if ($.fn.select2) {

                $('#genres-select').select2({
                    placeholder: "Оберіть жанри",
                    closeOnSelect: false,
                    width: '100%',
                    dropdownParent: $('#genres-select').parent()
                });

                $('#actors-select').select2({
                    placeholder: "Оберіть акторів",
                    closeOnSelect: false,
                    width: '100%',
                    dropdownParent: $('#actors-select').parent()
                });

            } else {
                console.warn("Select2 не підключений");
            }

        });
    </script>
}