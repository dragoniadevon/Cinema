@model Movie

@{
    ViewData["Title"] = Model.Title;
}

<h1 class="mb-4">🎬 @Model.Title</h1>

<div class="row g-4">

    <!-- 🎞 ЛІВА КОЛОНКА -->
    <div class="col-md-4">

        <div class="card shadow-sm">
            <div class="card-body text-center">

                @if (!string.IsNullOrWhiteSpace(Model.Posterurl))
                {
                    <img src="@Model.Posterurl" alt="Постер @Model.Title" class="img-fluid rounded mb-3"
                        style="height: 420px;" />
                }
                else
                {
                    <div class="text-muted fst-italic mb-3">
                        Постер відсутній
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Trailerurl))
                {
                    <a href="@Model.Trailerurl" target="_blank" class="btn btn-danger w-100 mb-2">
                        ▶ Дивитися трейлер
                    </a>
                }

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100">
                    ✏️ Редагувати
                </a>

            </div>
        </div>

    </div>

    <!-- ℹ️ ПРАВА КОЛОНКА -->
    <div class="col-md-8">

        <!-- 🔢 МЕТА-ІНФОРМАЦІЯ -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="mb-3">Інформація</h5>

                <ul class="list-group list-group-flush">
                    @if (Model.MovieGenres.Any())
                    {
                        <li class="list-group-item">
                            <strong>Жанри:</strong>
                            @string.Join(", ", Model.MovieGenres.Select(mg => mg.Genre.Name))
                        </li>
                    }

                    @if (Model.Rating.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Рейтинг:</strong> ⭐ @Model.Rating
                        </li>
                    }

                    @if (Model.Duration.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Тривалість:</strong> @Model.Duration хв
                        </li>
                    }

                    @if (Model.Agerating.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Віковий рейтинг:</strong>
                            @Html.DisplayFor(m => m.Agerating)
                        </li>
                    }

                    @if (Model.Releasedate.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Дата релізу:</strong>
                            @Model.Releasedate.Value.ToString("dd.MM.yyyy")
                        </li>
                    }

                    @if (Model.Languagecode.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Мова:</strong>
                            @Html.DisplayFor(m => m.Languagecode)
                        </li>
                    }

                    @if (Model.Countrycode.HasValue)
                    {
                        <li class="list-group-item">
                            <strong>Країна:</strong>
                            @Html.DisplayFor(m => m.Countrycode)
                        </li>
                    }

                    @if (Model.MovieActors.Any())
                    {
                        <li class="list-group-item">
                            <strong>В головних ролях:</strong>
                            @string.Join(", ", Model.MovieActors.Select(ma => ma.Actor.Fullname))
                        </li>
                    }

                </ul>

            </div>
        </div>

        <!-- 📝 ОПИС -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Опис</h5>
                    <p class="mb-0">@Model.Description</p>
                </div>
            </div>
        }

    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-4">
    ← Назад до списку
</a>