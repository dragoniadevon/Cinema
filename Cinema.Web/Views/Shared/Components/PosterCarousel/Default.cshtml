@model List<PosterCarouselItemVm>

@if (Model != null && Model.Any())
{
    <div class="full-screen-carousel-wrapper">
        <button class="carousel-nav-btn prev-btn" onclick="scrollCarousel(-1)">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button class="carousel-nav-btn next-btn" onclick="scrollCarousel(1)">
            <i class="bi bi-chevron-right"></i>
        </button>

        <div class="poster-carousel">
            @foreach (var movie in Model)
            {
                <div class="poster-card" tabindex="0">
                    <div class="poster-image-container">
                        <img src="@movie.PosterUrl" class="poster-img" alt="Постер до фільму @movie.Title" loading="lazy" />

                        <div class="poster-multiplex-overlay">
                            <div class="overlay-header">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="action-item">
                                    <i class="bi bi-info-circle"></i>
                                    <span>Детальніше</span>
                                </a>
                                @if (!string.IsNullOrEmpty(movie.TrailerUrl))
                                {
                                    <a href="@movie.TrailerUrl" target="_blank" rel="noopener" class="action-item">
                                        <i class="bi bi-play-circle"></i>
                                        <span>Трейлер</span>
                                    </a>
                                }
                            </div>

                            <div class="overlay-schedule text-center w-100 px-2" 
                                 data-movie-id="@movie.MovieId" 
                                 data-cinema-id="@movie.SelectedCinemaId">
     
                                <div class="cinema-name-giant mb-1">
                                    @movie.SelectedCinemaName.ToUpper()
                                </div>

                                <div class="dropdown mb-4">
                                    <button class="btn btn-sm text-white border-0 fw-bold home-date-btn text-uppercase p-0 dropdown-toggle shadow-none" 
                                            type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-calendar3 me-1"></i> 
                                        <span class="selected-date-text">СЬОГОДНІ</span>
                                    </button>
        
                                    @{
                                        var futureDates = movie.AvailableDates.Where(d => d.Date >= DateTime.Today).ToList();
                                    }

                                    @if (futureDates.Count > 1)
                                    {
                                        <ul class="dropdown-menu shadow-lg border-0 rounded-4 mt-2 scrollable-menu">
                                            @foreach (var date in futureDates)
                                            {
                                                <li>
                                                    <a class="dropdown-item fw-bold py-2 @(date.Date == DateTime.Today ? "text-primary" : "")" 
                                                       href="javascript:void(0)" 
                                                       onclick="updateHomeSessions(this, '@date.ToString("yyyy-MM-dd")', '@date.ToString("ddd, dd MMMM").ToUpper()')">
                                                        @date.ToString("ddd, dd MMMM").ToUpper()
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="d-flex flex-wrap justify-content-center gap-4 session-container">
                                    @if (movie.TodaySessions.Any())
                                    {
                                        @foreach (var session in movie.TodaySessions)
                                        {
                                            <a asp-controller="Sessions" asp-action="Details" asp-route-id="@session.SessionId"
                                               class="home-session-time" title="від @session.MinPrice.ToString("0") ₴">
                                                @session.StartTime.ToString("HH:mm")
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <div class="no-sessions-info animate-fade">
                                            <i class="bi bi-clock-history d-block mb-1"></i>
                                            <span>СЕАНСІВ НЕМАЄ</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="overlay-footer">
                                <h3 class="poster-title">@movie.Title</h3>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="no-sessions-wrapper d-flex flex-column align-items-center justify-content-center text-center py-5 shadow-sm mx-auto my-5 rounded-4 bg-white border"
         style="max-width: 600px;">
        <div class="display-1 text-muted opacity-25 mb-3">
            <i class="bi bi-calendar-x"></i>
        </div>
        <h3 class="fw-bold text-dark">На жаль, сеансів не знайдено</h3>
        <p class="text-muted px-4">
            У цьому кінотеатрі зараз немає активних сеансів. Спробуйте обрати іншу локацію або завітайте до нас пізніше.
        </p>
        <button class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" data-bs-toggle="modal"
                data-bs-target="#cityCinemaModal">
            <i class="bi bi-geo-alt-fill me-2"></i>Змінити кінотеатр
        </button>
    </div>
}
<style>
    .full-screen-carousel-wrapper {
        width: 100%;
        background-color: #000;
        overflow: hidden;
    }

    .poster-carousel {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        /* Firefox */
        -ms-overflow-style: none;
        /* IE/Edge */
    }

    .poster-carousel::-webkit-scrollbar {
        display: none;
        /* Chrome/Safari */
    }

    /* 2. КАРТКА ФІЛЬМУ */
    .poster-card {
        position: relative;
        flex: 0 0 25%;
        /* 4 афіші на екрані */
        min-width: 300px;
        height: 85vh;
        scroll-snap-align: start;
        cursor: pointer;
        outline: none;
    }

    .poster-image-container {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* 3. ОВЕРЛЕЙ ТА ГРАДІЄНТ */
    .poster-multiplex-overlay {
        position: absolute;
        inset: 0;
        /* Тільки нижній градієнт за замовчуванням */
        background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 40%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 2.5rem 1.5rem;
        transition: all 0.4s ease-in-out;
        z-index: 2;
    }

    /* Ефект при наведенні (затемнення + блюр) */
    .poster-card:hover .poster-multiplex-overlay,
    .poster-card:focus-within .poster-multiplex-overlay {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
    }

    /* 4. ЕЛЕМЕНТИ КЕРУВАННЯ */
    .overlay-header {
        display: flex;
        justify-content: space-around;
        opacity: 0;
        transform: translateY(-20px);
        transition: all 0.4s ease-out;
    }

    .action-item {
        color: #fff;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 0.8rem;
        font-weight: 500;
        gap: 8px;
        transition: opacity 0.2s;
    }

    .action-item i {
        font-size: 1.8rem;
    }

    .action-item:hover {
        color: #fff;
        opacity: 0.7;
    }

    /* 5. НАЗВА ФІЛЬМУ */
    .poster-title {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 800;
        text-align: center;
        text-transform: uppercase;
        margin: 0;
        letter-spacing: 1px;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    /* 6. АНІМАЦІЇ */
    .poster-card:hover .overlay-header,
    .poster-card:focus-within .overlay-header {
        opacity: 1;
        transform: translateY(0);
    }

    .poster-card:hover .poster-img,
    .poster-card:focus-within .poster-img {
        transform: scale(1.1);
    }

    /* Контейнер для позиціонування кнопок */
    .full-screen-carousel-wrapper {
        position: relative;
    }

    .carousel-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.3);
        /* Напівпрозорий фон */
        color: white;
        border: none;
        width: 60px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        z-index: 10;
        cursor: pointer;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

    .carousel-nav-btn:hover {
        background: rgba(0, 0, 0, 0.8);
        font-size: 3rem;
    }

    .prev-btn {
        left: 10px;
    }

    .next-btn {
        right: 10px;
    }

    @@media (max-width: 768px) {
        .carousel-nav-btn {
            display: none;
        }
    }

    @@media (max-width: 1200px) {
        .poster-card {
            flex: 0 0 33.333%;
        }
    }

    @@media (max-width: 992px) {
        .poster-card {
            flex: 0 0 50%;
        }
    }

    @@media (max-width: 576px) {
        .poster-card {
            flex: 0 0 85%;
            height: 70vh;
        }

        .poster-title {
            font-size: 1.2rem;
        }
    }
    .overlay-schedule {
        opacity: 0;
        transform: scale(0.9);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        margin: auto 0;
        z-index: 10;
        pointer-events: none;
    }
    .poster-card:hover .overlay-schedule {
        opacity: 1;
        transform: scale(1);
        pointer-events: auto;
    }
    .cinema-name-giant {
        color: #fff;
        font-size: 2.2rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -1px;
        line-height: 0.9;
        margin-bottom: 10px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.6);
    }
    .home-date-btn::after { display: none; }
    .home-date-btn:hover { text-decoration: underline; }
    .scrollable-menu {
        display: none; 
        max-height: 160px !important;
        overflow-y: auto !important;
        background: rgba(0, 0, 0, 0.3) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        width: 220px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37) !important;
    }
    .dropdown-menu.show.scrollable-menu {
        display: block !important;
    }
    .scrollable-menu .dropdown-item {
        color: rgba(255, 255, 255, 0.9) !important;
        transition: 0.2s;
    }
    .scrollable-menu .dropdown-item:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
    }
    .scrollable-menu .dropdown-item.text-primary {
        color: #0d6efd !important;
    }
    .scrollable-menu::-webkit-scrollbar { width: 4px; }
    .scrollable-menu::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 10px; }
    .home-session-time {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 900;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }
    .home-session-time:hover { color: #0d6efd !important; transform: translateY(-3px); }
    .no-sessions-msg {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 5px;
    }
    .session-container {
        min-height: 40px;
        transition: all 0.3s ease;
    }
    .scrollable-menu .dropdown-item.active-date {
        background: rgba(13, 110, 253, 0.2) !important;
        color: #0d6efd !important;
    }
    .no-sessions-info {
        color: rgba(255, 255, 255, 0.6);
        text-align: center;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 10px 0;
    }
    .no-sessions-info i {
        font-size: 1.4rem;
        color: #ffc107;
        opacity: 0.8;
    }
    .animate-fade {
        animation: fadeInHome 0.4s ease-in-out;
    }
    @@keyframes fadeInHome {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    function scrollCarousel(direction) {
        const carousel = document.querySelector(".poster-carousel");
        const firstCard = carousel?.querySelector(".poster-card");

        if (carousel && firstCard) {
            const step = firstCard.offsetWidth;

            carousel.scrollBy({
                left: step * direction,
                behavior: 'smooth'
            });
        }
    }
    async function updateHomeSessions(element, dateValue, labelText) {
        const card = element.closest('.poster-card');
        const container = card.querySelector('.session-container');
        const dateSpan = card.querySelector('.selected-date-text');

        const movieId = card.querySelector('.overlay-schedule').dataset.movieId;
        const cinemaId = card.querySelector('.overlay-schedule').dataset.cinemaId;

        dateSpan.innerText = labelText;
        container.style.opacity = '0.3';

        try {
            const response = await fetch(`/Home/GetSessionsForDate?movieId=${movieId}&cinemaId=${cinemaId}&date=${dateValue}`);
            const sessions = await response.json();

            container.innerHTML = '';
            container.style.opacity = '1';

            if (sessions && sessions.length > 0) {
                sessions.forEach(s => {
                    const link = document.createElement('a');
                    link.href = `/Sessions/Details/${s.sessionId}`;
                    link.className = 'home-session-time';
                    link.innerText = s.startTime;
                    link.title = `від ${s.minPrice} ₴`;
                    container.appendChild(link);
                });
            } else {
                container.innerHTML = `
                    <div class="no-sessions-info animate-fade">
                        <i class="bi bi-clock-history d-block mb-1"></i>
                        <span>СЕАНСІВ НЕМАЄ</span>
                    </div>`;
            }
        } catch (error) {
            console.error("Error:", error);
            container.style.opacity = '1';
            container.innerHTML = '<span class="text-danger small">ПОМИЛКА МЕРЕЖІ</span>';
        }

        const dd = bootstrap.Dropdown.getInstance(card.querySelector('.home-date-btn'));
        if (dd) dd.hide();
    }
</script>