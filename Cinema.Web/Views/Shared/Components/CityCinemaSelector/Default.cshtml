@model List<CityCinemaGroupVm>

<div class="modal fade" id="cityCinemaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h4 class="modal-title fw-bold text-dark">📍 Оберіть локацію</h4>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-0">
                    <div class="col-md-4 border-end">
                        <div class="pe-3">
                            <p class="small text-muted text-uppercase fw-bold mb-3" style="letter-spacing: 0.5px;">Місто
                            </p>
                            <div class="list-group list-group-flush border-0" id="city-list">
                                @foreach (var city in Model)
                                {
                                    <button
                                        class="list-group-item list-group-item-action border-0 rounded-3 mb-1 city-item d-flex justify-content-between align-items-center py-2"
                                        data-city="@city.City">
                                        <span>@city.City</span>
                                        <i class="bi bi-chevron-right small opacity-50"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="ps-md-4 mt-4 mt-md-0">
                            <p class="small text-muted text-uppercase fw-bold mb-3" style="letter-spacing: 0.5px;">
                                Оберіть кінотеатр</p>
                            @foreach (var city in Model)
                            {
                                <div class="city-block d-none animate-fade-in" data-city="@city.City">
                                    <div class="row g-3">
                                        @foreach (var cinema in city.Cinemas)
                                        {
                                            <div class="col-12">
                                                <div class="cinema-selection-card p-3 border rounded-3 transition-hover h-100">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold mb-0 text-dark">@cinema.Name</h6>
                                                        <span
                                                            class="badge bg-primary bg-opacity-10 text-primary small fw-normal">Кінотеатр</span>
                                                    </div>

                                                    <p class="text-muted small mb-3">
                                                        <i class="bi bi-geo-alt me-1"></i> @cinema.Address
                                                    </p>

                                                    <div class="d-flex gap-2 mt-auto">
                                                        <button type="button"
                                                            class="btn btn-primary btn-sm px-3 shadow-sm select-cinema fw-bold"
                                                            data-city="@city.City" data-cinema-id="@cinema.Id"
                                                            data-cinema-name="@cinema.Name">
                                                            Обрати
                                                        </button>
                                                        <a class="btn btn-light btn-sm px-3 text-muted border schedule-link"
                                                            data-city="@city.City" data-cinema-name="@cinema.Name"
                                                            data-cinema-id="@cinema.Id" asp-controller="Sessions"
                                                            asp-action="Index" asp-route-city="@city.City"
                                                            asp-route-cinemaId="@cinema.Id">
                                                            <i class="bi bi-calendar3 me-1"></i> Розклад
                                                        </a>

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Плавна поява блоків */
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Стиль списку міст */
    .city-item {
        transition: all 0.2s ease;
        font-weight: 500;
        color: #495057;
    }

    .city-item.active-city {
        background-color: #e7f1ff !important;
        color: #0d6efd !important;
        font-weight: 700;
    }

    /* Картки кінотеатрів */
    .cinema-selection-card {
        background-color: #fff;
        transition: all 0.2s ease-in-out;
    }

    .cinema-selection-card:hover {
        border-color: #0d6efd !important;
        background-color: #f8f9ff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.08);
    }

    /* Кастомізація скролбару для модалки, якщо міст багато */
    #city-list {
        max-height: 400px;
        overflow-y: auto;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cityButtons = document.querySelectorAll(".city-item");
        const cityBlocks = document.querySelectorAll(".city-block");

        cityButtons.forEach(btn => {
            btn.addEventListener("click", () => {
                const city = btn.dataset.city;

                // Сховати всі блоки кінотеатрів
                cityBlocks.forEach(block => block.classList.add("d-none"));

                // Показати обране місто
                const activeBlock = document.querySelector(`.city-block[data-city="${city}"]`);
                if (activeBlock) {
                    activeBlock.classList.remove("d-none");
                }

                // Підсвітка активного міста
                cityButtons.forEach(b => b.classList.remove("active-city"));
                btn.classList.add("active-city");
            });
        });

        // Вибір кінотеатру
        document.querySelectorAll(".select-cinema").forEach(btn => {
            btn.addEventListener("click", () => {
                const city = btn.dataset.city;
                const cinemaName = btn.dataset.cinemaName;
                const cinemaId = btn.dataset.cinemaId;

                // Cookie
                document.cookie = `selectedCity=${encodeURIComponent(city)}; path=/`;
                document.cookie = `selectedCinemaName=${encodeURIComponent(cinemaName)}; path=/`;
                document.cookie = `selectedCinemaId=${cinemaId}; path=/`;

                // Закрити модалку
                const modalElement = document.getElementById("cityCinemaModal");
                const modal = bootstrap.Modal.getInstance(modalElement);
                modal.hide();

                // Оновити Navbar label
                const label = document.getElementById("cityCinemaLabel");
                if (label) {
                    label.innerHTML = `<i class="bi bi-geo-alt-fill me-2 text-primary"></i> ${city}, ${cinemaName}`;
                }

                // Можна додати перезавантаження сторінки, якщо контент залежить від локації
                // window.location.reload();
            });
        });

        // Відкрити перше місто автоматично
        if (cityButtons.length > 0) {
            cityButtons[0].click();
        }
    });
</script>
<script>
    document.querySelectorAll(".schedule-link").forEach(link => {
        link.addEventListener("click", () => {
            const city = link.dataset.city;
            const cinemaName = link.dataset.cinemaName;
            const cinemaId = link.dataset.cinemaId;

            document.cookie = `selectedCity=${encodeURIComponent(city)}; path=/`;
            document.cookie = `selectedCinemaName=${encodeURIComponent(cinemaName)}; path=/`;
            document.cookie = `selectedCinemaId=${cinemaId}; path=/`;
        });
    });
</script>