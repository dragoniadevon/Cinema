<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema.Web.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg navbar-light mb-4">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="me-2">🎬</span> CINEMA WEB
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav ms-auto align-items-center gap-2">

                    <li class="nav-item me-lg-2">
                        <button id="cityCinemaLabel"
                                class="btn-select-location shadow-sm d-flex align-items-center"
                                data-bs-toggle="modal"
                                data-bs-target="#cityCinemaModal">
                            <i class="bi bi-geo-alt-fill me-2 text-primary"></i> Обрати місто
                        </button>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var firstName = User.FindFirst("FirstName")?.Value;
                        var avatarPath = User.FindFirst("AvatarPath")?.Value;

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center user-badge"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(avatarPath))
                                {
                                                                    }
                                👤 @(firstName ?? User.Identity?.Name)
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                                <li>
                                    <a class="dropdown-item rounded-3 mb-1"
                                       asp-controller="Profile"
                                       asp-action="Index">
                                        👤 Мій профіль
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item rounded-3 mb-1"
                                           asp-controller="Admin"
                                           asp-action="Index">
                                            🛠 Адмін-панель
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="dropdown-item rounded-3 text-danger d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-2"></i> Вийти
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-primary shadow-sm px-4 fw-bold"
                               asp-controller="Account"
                               asp-action="Login">
                                Увійти
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="flex-grow-1">
    <div class="container">
        @RenderBody()
    </div>
</main>

@await Component.InvokeAsync("CityCinemaSelector")

<footer class="footer text-muted border-top">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="fw-bold text-dark">🎬 Cinema Web</div>
            <div class="small">
                &copy; 2026 Всі права захищені &bull;
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">
                    Конфіденційність
                </a>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    (function () {
        function getCookie(name) {
            const value = "; " + document.cookie;
            const parts = value.split("; " + name + "=");
            if (parts.length === 2) return parts.pop().split(";").shift();
            return null;
        }

        const city = getCookie("selectedCity");
        const cinemaName = getCookie("selectedCinemaName");

        if (city && cinemaName) {
            const label = document.getElementById("cityCinemaLabel");
            if (label) {
                label.innerHTML =
                    '<i class="bi bi-geo-alt-fill me-2 text-primary"></i>' +
                    decodeURIComponent(city) + ", " + decodeURIComponent(cinemaName);
            }
        }
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
